---
import Layout from "../layouts/Layout.astro";
---

<Layout>
    <div class="error404">
        <h1>404</h1>

        <p>This page doesn't exist.</p>
        <a href="/"> Go back to Make-ard </a>
    </div>
</Layout>

<style>
    .error404 {
        margin-top: 64px;
        display: flex;
        flex-direction: column;
        margin-inline: auto;
        max-width: 720px;
        align-items: center;
        gap: 16px;
    }

    h1 {
        font-family: "Ubuntu sans", sans-serif;
        font-weight: 900;
        font-size: 48px;
        color: var(--ink);
    }

    p {
        font-family: "Google sans", sans-serif;
        color: var(--muted);
    }

    a {
        text-decoration: none;
        font-size: 16px;
        font-weight: bold;
        font-family: "Google sans", sans-serif;
        color: #fff;
        background-color: var(--accent);
        padding: 12px 16px;
        border-radius: 8px;
    }
</style>
