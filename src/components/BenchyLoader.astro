---
const { size = "32", class: className, ...rest } = Astro.props;
---

<svg
    xmlns="http://www.w3.org/2000/svg"
    xmlns:xlink="http://www.w3.org/1999/xlink"
    width={size}
    height={size}
    viewBox="0 0 667 667"
    version="1.1"
    class={className}
    xml:space="preserve"
    style="fill-rule:evenodd;clip-rule:evenodd;stroke-linejoin:round;stroke-miterlimit:2;"
    {...rest}
>
    <g transform="matrix(0.666667,0,0,0.666667,0,0)">
        <g>
            <path
                class="part-4"
                d="M958.003,796.909L917.893,887.729C915.31,893.577 909.516,897.351 903.12,897.351L281.112,897.35C277.841,897.35 274.647,896.357 271.953,894.502C224.687,861.913 185.5,829.133 153.043,796.909L958.003,796.909Z"
                fill="currentColor"></path>
            <path
                class="part-3"
                d="M647.5,598.234L987.747,682.753C992.372,683.902 996.254,687.034 998.352,691.312C1000.45,695.589 1000.55,700.574 998.625,704.932L975.552,757.174L116.049,757.174C66.934,699.867 38.063,645.404 21.402,598.234L647.5,598.234Z"
                fill="currentColor"></path>
            <path
                class="part-2"
                d="M621.234,399.558L621.234,558.499L9.636,558.499C-1.309,512.716 -0.825,476.928 1.031,456.706C1.487,452.036 3.952,447.796 7.787,445.089C11.621,442.382 16.444,441.477 21,442.609L293.284,510.245L279.696,399.558L621.234,399.558Z"
                fill="currentColor"></path>
            <path
                class="part-1"
                d="M274.819,359.823L260.895,246.404C260.302,241.568 261.925,236.724 265.313,233.221C268.701,229.719 273.491,227.933 278.347,228.362L507.254,248.607C510.48,248.893 513.664,247.711 515.922,245.389C518.18,243.068 519.272,239.854 518.895,236.638L505.304,120.665C504.767,116.089 506.213,111.502 509.278,108.06C512.342,104.618 516.732,102.649 521.342,102.649L605.085,102.649C609.368,102.649 613.476,104.349 616.504,107.376C619.533,110.403 621.234,114.507 621.234,118.788L621.234,359.823L274.819,359.823Z"
                fill="currentColor"></path>
        </g>
    </g>
</svg>

<style>
    .part-1,
    .part-2,
    .part-3,
    .part-4 {
        animation-duration: 1.3s;
        animation-timing-function: ease-in;
        animation-iteration-count: infinite;
    }

    .part-4 {
        animation-name: load-4;
    }

    .part-3 {
        animation-name: load-3;
    }

    .part-2 {
        animation-name: load-2;
    }

    .part-1 {
        animation-name: load-1;
    }

    @keyframes load-4 {
        0%,
        9% {
            opacity: 0;
        }

        18% {
            opacity: 1;
        }

        100% {
            opacity: 1;
        }
    }

    @keyframes load-3 {
        0%,
        23% {
            opacity: 0;
        }

        32% {
            opacity: 1;
        }

        100% {
            opacity: 1;
        }
    }

    @keyframes load-2 {
        0%,
        37% {
            opacity: 0;
        }

        46% {
            opacity: 1;
        }

        100% {
            opacity: 1;
        }
    }

    @keyframes load-1 {
        0%,
        51% {
            opacity: 0;
        }

        60% {
            opacity: 1;
        }

        100% {
            opacity: 1;
        }
    }
</style>
