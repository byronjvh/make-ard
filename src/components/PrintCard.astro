---
import Nozzle from "./icons/Nozzle.astro";
import {
    Clock,
    Spool,
    RulerDimensionLine,
    LayersArrowDown,
    WavesHorizontal,
    BrickWall,
    Box,
    Landmark,
} from "@lucide/astro";
---

<article class="print-card theme-blueprint">
    <header>
        <img
            class="print-card-thumbnail"
            src="https://media.printables.com/media/prints/203925/images/1875500_cd7c1d22-dfb1-4c56-8e28-71fd9454dc74/thumbs/inside/1280x960/jpg/7b62dfe39e94e61584a93da27d085074_display_large_20.webp"
            alt=""
        />
        <div class="print-card-header-text">
            <div>
                <h3>Título de la card</h3>
                <p class="print-card-description">
                    Esto es una descripción corta del modelo
                </p>
            </div>
            <div class="print-card-header-info">
                <div>
                    <span>
                        <Clock
                            class="icon-header"
                            size={32}
                            stroke-width={1.5}
                        />
                    </span>
                    <h4>Print Time</h4>
                    <p>2h 34m</p>
                </div>
                <!-- <span class="separator"></span> -->
                <div>
                    <span>
                        <Spool
                            class="icon-header"
                            size={32}
                            stroke-width={1.5}
                        />
                    </span>
                    <h4>Filament Used</h4>

                    <p>24.6 g</p>
                </div>
                <!-- <span class="separator"></span> -->
                <div>
                    <span>
                        <RulerDimensionLine
                            class="icon-header"
                            size={32}
                            stroke-width={1.5}
                        />
                    </span>
                    <h4>Dimensions</h4>
                    <p>120×85×43 mm</p>
                </div>
            </div>
        </div>
    </header>
    <span class="separator-horizontal"></span>
    <ul class="print-card-list">
        <li class="print-card-list-item">
            <LayersArrowDown class="icon-data" size={26} stroke-width={1.5} />
            <div>
                <h4>Layer Height</h4>
                <span> 0.20 mm </span>
            </div>
        </li>
        <li class="print-card-list-item">
            <WavesHorizontal
                class="icon-border icon-data"
                size={22}
                stroke-width={2}
            />
            <div>
                <h4>Infill</h4>
                <span> 15% Gyroid </span>
            </div>
        </li>
        <li class="print-card-list-item">
            <BrickWall class="icon-data" stroke-width={1.5} size={26} />
            <div>
                <h4>Walls</h4>
                <span> 3 walls </span>
            </div>
        </li>
        <li class="print-card-list-item">
            <Box class="icon-data" size={26} stroke-width={1.5} />
            <div>
                <h4>Material</h4>
                <span> PLA </span>
            </div>
        </li>
        <li class="print-card-list-item">
            <Nozzle class="icon-data" size={22} stroke-width={1.5} />
            <div>
                <h4>Nozzle</h4>
                <span> 0.4 mm </span>
            </div>
        </li>
        <li class="print-card-list-item">
            <Landmark class="icon-data" size={26} stroke-width={1.5} />
            <div>
                <h4>Supports</h4>
                <span> No </span>
            </div>
        </li>
    </ul>
    <footer class="print-card-footer">
        <p class="print-card-printer">Flashforge AD5X</p>
        <p class="signature">Made by @byronjvh</p>
    </footer>
</article>

<script></script>

<style>
    * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
    }

    .print-card {
        --bg-color: #fff;
        --border-color: rgba(0, 0, 0, 0.1);
        --font-title: "Montserrat", sans-serif;
        --font-data: "Ubuntu Mono", sans-serif;
        --font-default: "Google sans", sans-serif;
        --bg-footer: rgba(0, 0, 0, 0.1);
        --icon-color: #88f;
        --icon-color-2: #66a;
        --title-color: #226;
        --description-color: #445;
        --data-color: #112;
        --subtitle-color: #667;

        width: 100%;
        max-width: 560px;
        aspect-ratio: 1600/1200;
        background-color: var(--bg-color);
        padding: 22px;
        display: flex;
        flex-direction: column;
        border-radius: 16px;
        box-shadow: 0 10px 10px 6px rgba(0, 0, 0, 0.05);
        gap: 20px;
        margin-bottom: 32px;
        margin-top: 32px;
        font-family: var(--font-default);
    }

    .print-card header {
        display: flex;
        gap: 20px;
        height: 160px;
        max-height: 160px;
    }

    .print-card-header-text {
        display: flex;
        flex-direction: column;
        gap: 20px;
        color: var(--description-color);
    }

    .print-card h3 {
        padding-top: 8px;
        height: 42px;
        font-size: 28px;
        margin: 0;
        margin-bottom: 2px;
        color: var(--title-color);
        font-family: var(--font-title);
    }

    .print-card-header-info {
        display: flex;
        gap: 28px;
        height: 100%;
        font-size: 18px;
        font-weight: 600;
        font-family: var(--font-data);
        color: var(--data-color);
    }

    .print-card-header-info h4 {
        font-family: var(--font-default);
        text-transform: uppercase;
        font-size: 11px;
        color: var(--subtitle-color);
    }

    .print-card-header-info .separator {
        width: 2px;
        height: 100%;
        background-color: var(--border-color);
    }

    .separator-horizontal {
        width: 100%;
        height: 2px;
        flex: 0 0 2px;

        background-color: var(--border-color);
    }

    .print-card-description {
        font-size: 14px;
        font-weight: 600;
        opacity: 0.5;
    }

    .print-card-thumbnail {
        width: 160px;
        aspect-ratio: 1/1;
        object-fit: cover;
        border-radius: 8px;
    }

    .print-card-list {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 8px;
        width: 100%;
        font-family: "Ubuntu mono", sans-serif;
        font-weight: 600;
        font-size: 18px;
    }

    .print-card-list-item {
        display: flex;
        gap: 8px;
        height: 50px;
        width: 100%;
        align-items: center;
        justify-content: left;
        font-size: 16px;
        list-style: none;
        padding-left: 4px;
        color: var(--data-color);
    }

    .print-card-list-item h4 {
        color: var(--subtitle-color);
        font-family: "Google sans";
        text-transform: uppercase;
        font-size: 11px;
    }

    .icon-border {
        border: 2px solid currentColor;
        border-radius: 4px;
    }

    .print-card-footer {
        padding: 12px;
        border-radius: 10px;
        background-color: var(--bg-footer);
        margin-top: auto;
        display: flex;
        justify-content: space-between;
    }

    .icon-header {
        color: var(--icon-color);
    }
    .icon-data {
        color: var(--icon-color-2);
    }

    .print-card-printer {
        font-weight: 600;
    }

    .signature {
        font-size: 14px;
        color: var(--subtitle-color);
    }

    /* Themes */
    .theme-blueprint {
        --bg-color: #e8f1f7;
        --border-color: rgba(25, 76, 110, 0.18);

        --font-title: "Goldman", sans-serif;
        --font-data: "Ubuntu Mono", sans-serif;
        --font-default: "Google sans", sans-serif;

        --bg-footer: #d4e4ee;

        --icon-color: #1673a5;
        --icon-color-2: #066395;
        --title-color: #123d5b;
        --description-color: #55758a;
        --data-color: #163c54;
        --subtitle-color: #58778a;
    }
</style>
