---
import Nozzle from "./icons/Nozzle.astro";
import {
    Clock,
    Spool,
    RulerDimensionLine,
    LayersArrowDown,
    WavesHorizontal,
    BrickWall,
    Box,
    Landmark,
} from "@lucide/astro";
---

<article id="print-card" class="print-card hide">
    <header>
        <img
            class="print-card-thumbnail"
            src="https://media.printables.com/media/prints/203925/images/1875500_cd7c1d22-dfb1-4c56-8e28-71fd9454dc74/thumbs/inside/1280x960/jpg/7b62dfe39e94e61584a93da27d085074_display_large_20.webp"
            alt=""
        />
        <div class="print-card-header-text">
            <div>
                <h3>Título de la card</h3>
                <p class="print-card-description">
                    Esto es una descripción corta del modelo
                </p>
            </div>
            <div class="print-card-header-info">
                <div>
                    <span>
                        <Clock
                            class="icon-header"
                            size={32}
                            stroke-width={1.5}
                        />
                    </span>
                    <h4>Print Time</h4>
                    <p>2h 34m</p>
                </div>
                <!-- <span class="separator"></span> -->
                <div>
                    <span>
                        <Spool
                            class="icon-header"
                            size={32}
                            stroke-width={1.5}
                        />
                    </span>
                    <h4>Filament Used</h4>

                    <p>24.6 g</p>
                </div>
                <!-- <span class="separator"></span> -->
                <div>
                    <span>
                        <RulerDimensionLine
                            class="icon-header"
                            size={32}
                            stroke-width={1.5}
                        />
                    </span>
                    <h4>Dimensions</h4>
                    <p>999×999×999 mm</p>
                </div>
            </div>
        </div>
    </header>
    <span class="separator-horizontal"></span>
    <ul class="print-card-list">
        <li class="print-card-list-item">
            <LayersArrowDown class="icon-data" size={26} stroke-width={1.5} />
            <div>
                <h4>Layer Height</h4>
                <span> 0.20 mm </span>
            </div>
        </li>
        <li class="print-card-list-item">
            <WavesHorizontal
                class="icon-border icon-data"
                size={22}
                stroke-width={2}
            />
            <div>
                <h4>Infill</h4>
                <span> 15% Gyroid </span>
            </div>
        </li>
        <li class="print-card-list-item">
            <BrickWall class="icon-data" stroke-width={1.5} size={26} />
            <div>
                <h4>Walls</h4>
                <span> 3 walls </span>
            </div>
        </li>
        <li class="print-card-list-item">
            <Box class="icon-data" size={26} stroke-width={1.5} />
            <div>
                <h4>Material</h4>
                <span> PLA </span>
            </div>
        </li>
        <li class="print-card-list-item">
            <Nozzle class="icon-data" size={22} stroke-width={1.5} />
            <div>
                <h4>Nozzle</h4>
                <span> 0.4 mm </span>
            </div>
        </li>
        <li class="print-card-list-item">
            <Landmark class="icon-data" size={26} stroke-width={1.5} />
            <div>
                <h4>Supports</h4>
                <span> No </span>
            </div>
        </li>
    </ul>
    <footer class="print-card-footer">
        <p class="print-card-printer">Flashforge AD5X</p>
        <p class="signature">Made by @byronjvh</p>
    </footer>
</article>

<script>
    import { formatMetadata } from "../logic/formatMetadata";
    import type { PrintCardMetadata } from "../logic/extractPrintCardMetadata";
    let metadata: PrintCardMetadata | undefined;

    window.addEventListener("gcode-preview-ready", (event) => {
        const detail = (event as CustomEvent).detail;

        const image = detail.image;
        metadata = detail.metadata;

        if (metadata) {
            console.log("parsed metadata", formatMetadata(metadata));
            console.log("metadata", metadata);
        }

        const preview = document.querySelector(
            ".print-card-thumbnail",
        ) as HTMLImageElement;

        if (!preview) return;

        preview.src = image;
    });
</script>

<style>
    * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
    }

    .print-card {
        --bg-color: #fff;
        --bg-img: #dfdfff;
        --model-color: #d200e6;
        --border-color: rgba(0, 0, 0, 0.1);
        --font-title: "Montserrat", sans-serif;
        --font-data: "Ubuntu Mono", sans-serif;
        --font-default: "Google sans", sans-serif;
        --bg-footer: rgba(0, 0, 0, 0.1);
        --icon-color: #88f;
        --icon-color-2: #66a;
        --title-color: #226;
        --description-color: #445;
        --data-color: #112;
        --subtitle-color: #667;

        width: 100%;
        max-width: 560px;
        aspect-ratio: 1600/1200;
        background-color: var(--bg-color);
        padding: 22px;
        display: flex;
        flex-direction: column;
        border-radius: 16px;
        box-shadow: 0 10px 10px 6px rgba(0, 0, 0, 0.05);
        gap: 20px;
        font-family: var(--font-default);
    }

    .print-card header {
        display: flex;
        gap: 20px;
        height: 160px;
        max-height: 160px;
    }

    .print-card-header-text {
        display: flex;
        flex-direction: column;
        gap: 20px;
        color: var(--description-color);
    }

    .print-card h3 {
        padding-top: 8px;
        height: 42px;
        font-size: 28px;
        margin: 0;
        margin-bottom: 2px;
        color: var(--title-color);
        font-family: var(--font-title);
    }

    .print-card-header-info {
        display: flex;
        gap: 28px;
        height: 100%;
        font-size: 18px;
        font-weight: 600;
        font-family: var(--font-data);
        color: var(--data-color);
    }

    .print-card-header-info h4 {
        font-family: var(--font-default);
        text-transform: uppercase;
        font-size: 11px;
        color: var(--subtitle-color);
    }

    .print-card-header-info .separator {
        width: 2px;
        height: 100%;
        background-color: var(--border-color);
    }

    .separator-horizontal {
        width: 100%;
        height: 2px;
        flex: 0 0 2px;

        background-color: var(--border-color);
    }

    .print-card-description {
        font-size: 14px;
        font-weight: 600;
        opacity: 0.5;
    }

    .print-card-thumbnail {
        width: 160px;
        aspect-ratio: 1/1;
        object-fit: cover;
        border-radius: 8px;
        background-color: var(--bg-img);
    }

    .print-card-list {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 8px;
        width: 100%;
        font-family: "Ubuntu mono", sans-serif;
        font-weight: 600;
        font-size: 18px;
    }

    .print-card-list-item {
        display: flex;
        gap: 8px;
        height: 50px;
        width: 100%;
        align-items: center;
        justify-content: left;
        font-size: 16px;
        list-style: none;
        padding-left: 4px;
        color: var(--data-color);
    }

    .print-card-list-item h4 {
        color: var(--subtitle-color);
        font-family: "Google sans";
        text-transform: uppercase;
        font-size: 11px;
    }

    .icon-border {
        border: 2px solid currentColor;
        border-radius: 4px;
    }

    .print-card-footer {
        padding: 12px;
        border-radius: 10px;
        background-color: var(--bg-footer);
        margin-top: auto;
        display: flex;
        justify-content: space-between;
    }

    .icon-header {
        color: var(--icon-color);
    }
    .icon-data {
        color: var(--icon-color-2);
    }

    .print-card-printer {
        font-weight: 600;
        color: var(--description-color);
    }

    .signature {
        font-size: 14px;
        color: var(--subtitle-color);
    }

    /* 1. Blueprint */
    .print-card.theme-blueprint {
        --font-title: "Montserrat", sans-serif;
        --bg-color: #eef3fb;
        --bg-img: #dbe6fa;
        --border-color: rgba(20, 50, 90, 0.15);
        --bg-footer: rgba(20, 50, 90, 0.08);
        --icon-color: #2f6fed;
        --icon-color-2: #6a93e0;
        --title-color: #0f2a52;
        --description-color: #3c5578;
        --data-color: #10233f;
        --subtitle-color: #5c7291;
    }

    /* 2. Carbono */
    .print-card.theme-carbono {
        --font-title: "Righteous", sans-serif;
        --bg-color: #1b1e24;
        --bg-img: #2a2e37;
        --border-color: rgba(255, 255, 255, 0.08);
        --bg-footer: rgba(255, 255, 255, 0.06);
        --icon-color: #ff7a30;
        --icon-color-2: #c95d20;
        --title-color: #f4f4f2;
        --description-color: #b7bac2;
        --data-color: #f1f1ef;
        --subtitle-color: #8a8e98;
    }

    .print-card.theme-carbono h3 {
        letter-spacing: 2px;
    }

    /* 3. Cobre */
    .print-card.theme-cobre {
        --font-title: "Merriweather", serif;
        --bg-color: #f6efe3;
        --bg-img: #ecdec4;
        --border-color: rgba(120, 80, 40, 0.15);
        --bg-footer: rgba(120, 80, 40, 0.1);
        --icon-color: #b5651d;
        --icon-color-2: #8a4a15;
        --title-color: #3c2410;
        --description-color: #6b4c30;
        --data-color: #2e1c0c;
        --subtitle-color: #8a7156;
    }

    /* 4. Matcha */
    .print-card.theme-matcha {
        --font-title: "Great Vibes", cursive;
        --bg-color: #eef3ea;
        --bg-img: #dbe6d3;
        --border-color: rgba(60, 100, 50, 0.15);
        --bg-footer: rgba(60, 100, 50, 0.08);
        --icon-color: #4c7a3f;
        --icon-color-2: #7ba36a;
        --title-color: #1f3a18;
        --description-color: #47613c;
        --data-color: #142c0d;
        --subtitle-color: #6c8862;
    }

    /* 5. Neón */
    .print-card.theme-neon {
        --font-title: "Goldman", sans-serif;
        --bg-color: #0d0f1a;
        --bg-img: #1a1d2e;
        --border-color: rgba(255, 255, 255, 0.08);
        --bg-footer: rgba(255, 255, 255, 0.05);
        --icon-color: #37e6e6;
        --icon-color-2: #ff3fa4;
        --title-color: #f2f8ff;
        --description-color: #9fb4c9;
        --data-color: #e8fbff;
        --subtitle-color: #718aa3;
    }

    .print-card.hide {
        display: none;
    }
</style>
