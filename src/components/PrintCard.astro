---
import BenchyLoader from "./BenchyLoader.astro";
import Nozzle from "./icons/Nozzle.astro";
import {
    Clock,
    Spool,
    RulerDimensionLine,
    LayersArrowDown,
    WavesHorizontal,
    BrickWall,
    Box,
    Landmark,
} from "@lucide/astro";
---

<article id="printCard" class="printCard shadow theme-blueprint">
    <header>
        <div class="printCard-thumbnail-wrapper">
            <img
                class="printCard-thumbnail"
                src="https://media.printables.com/media/prints/203925/images/1875500_cd7c1d22-dfb1-4c56-8e28-71fd9454dc74/thumbs/inside/1280x960/jpg/7b62dfe39e94e61584a93da27d085074_display_large_20.webp"
                alt=""
            />
            <BenchyLoader
                size="52"
                id="printCard-loader"
                class="benchy-loader hide"
            />
        </div>
        <div class="printCard-header-text">
            <div>
                <h3 id="print-card-title">Título de la card</h3>
                <p id="print-card-description" class="printCard-description">
                    Descripción corta del modelo 3D
                </p>
            </div>
            <div class="printCard-header-info">
                <div data-field="printTime">
                    <span>
                        <Clock
                            class="icon-header"
                            size={32}
                            stroke-width={1.5}
                        />
                    </span>
                    <h4>Print Time</h4>
                    <p>2h 34m</p>
                </div>
                <!-- <span class="separator"></span> -->
                <div data-field="filamentUsed">
                    <span>
                        <Spool
                            class="icon-header"
                            size={32}
                            stroke-width={1.5}
                        />
                    </span>
                    <h4>Filament Used</h4>

                    <p>24.6 g</p>
                </div>
                <!-- <span class="separator"></span> -->
                <div data-field="dimensions">
                    <span>
                        <RulerDimensionLine
                            class="icon-header"
                            size={32}
                            stroke-width={1.5}
                        />
                    </span>
                    <h4>Dimensions</h4>
                    <p>999×999×999 mm</p>
                </div>
            </div>
        </div>
    </header>
    <span class="separator-horizontal"></span>
    <ul class="printCard-list">
        <li class="printCard-list-item">
            <LayersArrowDown class="icon-data" size={26} stroke-width={1.5} />
            <div data-field="layerHeight">
                <h4>Layer Height</h4>
                <p>0.20 mm</p>
            </div>
        </li>
        <li class="printCard-list-item">
            <WavesHorizontal
                class="icon-border icon-data"
                size={22}
                stroke-width={2}
            />
            <div data-field="infill">
                <h4>Infill</h4>
                <p>15% Gyroid</p>
            </div>
        </li>
        <li class="printCard-list-item">
            <BrickWall class="icon-data" stroke-width={1.5} size={26} />
            <div data-field="walls">
                <h4>Walls</h4>
                <p>3 walls</p>
            </div>
        </li>
        <li class="printCard-list-item">
            <Box class="icon-data" size={26} stroke-width={1.5} />
            <div data-field="material">
                <h4>Material</h4>
                <p>PLA</p>
            </div>
        </li>
        <li class="printCard-list-item">
            <Nozzle class="icon-data" size={22} stroke-width={1.5} />
            <div data-field="nozzleDiameter">
                <h4>Nozzle</h4>
                <p>0.4 mm</p>
            </div>
        </li>
        <li class="printCard-list-item">
            <Landmark class="icon-data" size={26} stroke-width={1.5} />
            <div data-field="supports">
                <h4>Supports</h4>
                <p>No</p>
            </div>
        </li>
    </ul>
    <footer class="printCard-footer">
        <p id="print-card-printer" class="printCard-printer">Flashforge AD5X</p>
        <p class="signature">
            Made by @
            <span id="print-card-signature">username</span>
        </p>
    </footer>
</article>

<script>
    import {
        formatMetadata,
        type FormattedPrintCardMetadata,
    } from "../logic/formatMetadata";

    import { printCardState } from "../logic/printCardState";
    import { defaultPrintCardUserData } from "../logic/PrintCardUserData";
    import type { PrintCardFormData } from "../logic/setupPrintCardForm";

    const printCardThumbnail = document.querySelector<HTMLImageElement>(
        ".printCard-thumbnail",
    );
    const benchyLoader = document.querySelector("#printCard-loader");
    const printCard = document.querySelector(".printCard");
    const printCardTitle =
        document.querySelector<HTMLParagraphElement>("#print-card-title");
    const printCardDescription = document.querySelector<HTMLParagraphElement>(
        "#print-card-description",
    );
    const printCardPrinter = document.querySelector<HTMLParagraphElement>(
        "#print-card-printer",
    );
    const printCardSignature = document.querySelector<HTMLSpanElement>(
        "#print-card-signature",
    );

    window.addEventListener("print-card-preview-ready", () => {
        const { preview } = printCardState;

        if (!printCardThumbnail || !preview) return;
        printCardThumbnail.src = preview;
    });

    window.addEventListener("print-card-metadata-ready", () => {
        const { printCardMetadata } = printCardState;

        if (!printCardMetadata || !printCardTitle || !printCardPrinter) return;

        printCardTitle.innerText =
            printCardMetadata.modelName?.replaceAll("_", " ") ||
            defaultPrintCardUserData.modelName;
        printCardPrinter.innerText =
            printCardMetadata.printer || defaultPrintCardUserData.printer;

        updatePrintCard(formatMetadata(printCardMetadata));
    });

    window.addEventListener("print-card-update", (event) => {
        const detail = (event as CustomEvent).detail;
        const loading = detail.loading;

        printCardThumbnail?.classList.toggle("hide", loading);
        benchyLoader?.classList.toggle("hide", !loading);
    });

    function updatePrintCard(metadata: FormattedPrintCardMetadata) {
        if (!printCard) return;

        const fields = printCard.querySelectorAll<HTMLElement>("[data-field]");

        fields.forEach((field) => {
            const fieldName = field.dataset.field;

            if (!fieldName) return;

            const key = fieldName as keyof FormattedPrintCardMetadata;
            const value = metadata[key];

            const valueElement = field.querySelector("p");

            if (!valueElement) return;

            valueElement.textContent = String(value ?? "");
        });
    }

    window.addEventListener("print-card-form-update", (e) => {
        const detail = (e as CustomEvent).detail as PrintCardFormData;
        if (
            !printCardTitle ||
            !printCardDescription ||
            !printCardPrinter ||
            !printCardSignature
        )
            return;
        printCardTitle.innerText =
            detail.modelName.replaceAll("_", " ") ||
            defaultPrintCardUserData.modelName;
        printCardDescription.innerText =
            detail.description || defaultPrintCardUserData.description;
        printCardPrinter.innerText =
            detail.printer || defaultPrintCardUserData.printer;
        printCardSignature.innerText =
            detail.signature || defaultPrintCardUserData.signature;

        updatePrintCard(detail);
    });
</script>

<style>
    .printCard {
        --bg-color: #eef3fb;
        --bg-img: #dbe6fa;
        --model-color: #c8a85a;
        --border-color: rgba(0, 0, 0, 0.2);
        --font-title: "Montserrat", sans-serif;
        --font-data: "Ubuntu Mono", sans-serif;
        --font-default: "Google sans", sans-serif;
        --bg-footer: rgba(0, 0, 0, 0.1);
        --icon-color: #88f;
        --icon-color-2: #66a;
        --title-color: #226;
        --description-color: #445;
        --data-color: #112;
        --subtitle-color: #667;
        --shadow: 0px 6px 12px rgba(0, 0, 0, 0.1);
        --border: 2px solid var(--icon-color-2);

        width: var(--card-width);
        height: var(--card-height);

        transform: scale(var(--card-scale));
        transform-origin: top left;
        background-color: var(--bg-color);
        padding: 22px;
        display: inline-flex;
        flex-direction: column;
        border-radius: 16px;
        gap: 20px;
        font-family: var(--font-default);
        border: 2px solid transparent;
    }

    .printCard header {
        display: flex;
        gap: 20px;
        height: 160px;
        max-height: 160px;
        align-items: start;
    }

    .printCard-header-text {
        display: flex;
        flex-direction: column;
        gap: 20px;
        color: var(--description-color);
        padding-top: 4px;
        width: 100%;
        height: 100%;
    }

    .printCard h3 {
        height: 42px;
        font-size: 28px;
        margin: 0;
        color: var(--title-color);
        font-family: var(--font-title);
        text-transform: capitalize;
    }

    .printCard-header-info {
        display: flex;
        gap: 28px;
        height: 100%;
        font-size: 18px;
        font-weight: 600;
        font-family: var(--font-data);
        color: var(--data-color);
    }

    .printCard-header-info h4 {
        font-family: var(--font-default);
        text-transform: uppercase;
        font-size: 11px;
        color: var(--subtitle-color);
    }

    .printCard-header-info .separator {
        width: 2px;
        height: 100%;
        background-color: var(--border-color);
    }

    .separator-horizontal {
        width: 100%;
        height: 1px;
        flex: 0 0 1px;

        background-color: var(--border-color);
    }

    .printCard-description {
        font-size: 14px;
        font-weight: 600;
        opacity: 0.5;
    }

    .printCard-thumbnail-wrapper {
        min-width: 160px;
        width: 160px;
        height: 160px;
        border-radius: 8px;
        background-color: var(--bg-img);
        display: flex;
        justify-content: center;
        align-items: center;
        object-fit: cover;
        overflow: hidden;
    }
    .printCard-thumbnail {
        object-fit: cover;
        width: 160px;
        height: 160px;
    }
    .printCard-thumbnail.hide {
        display: none;
    }
    .benchy-loader.hide {
        display: none;
    }
    .benchy-loader {
        color: var(--model-color);
        filter: brightness(0.92) contrast(1.2) saturate(1.8) hue-rotate(-5deg);
    }
    .printCard-list {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 8px;
        width: 100%;
        font-family: "Ubuntu mono", sans-serif;
        font-weight: 600;
        font-size: 18px;
    }

    .printCard-list-item {
        display: flex;
        gap: 8px;
        height: 50px;
        width: 100%;
        align-items: center;
        justify-content: left;
        font-size: 16px;
        list-style: none;
        padding-left: 4px;
        color: var(--data-color);
    }

    .printCard-list-item h4 {
        color: var(--subtitle-color);
        font-family: "Google sans";
        text-transform: uppercase;
        font-size: 11px;
    }

    .icon-border {
        border: 2px solid currentColor;
        border-radius: 4px;
    }

    .printCard-footer {
        padding: 12px;
        border-radius: 10px;
        background-color: var(--bg-footer);
        margin-top: auto;
        display: flex;
        justify-content: space-between;
    }

    .icon-header {
        color: var(--icon-color);
    }
    .icon-data {
        color: var(--icon-color-2);
    }

    .printCard-printer {
        font-weight: 600;
        color: var(--description-color);
    }

    .signature {
        font-size: 14px;
        color: var(--subtitle-color);
    }

    /* 1. Blueprint */
    .printCard.theme-blueprint {
        --font-title: "Montserrat", sans-serif;
        --bg-color: #fdfeff;
        --bg-img: #ebeefa;
        --model-color: #c8a85a;
        --border-color: rgba(20, 50, 90, 0.25);
        --bg-footer: rgba(20, 50, 90, 0.08);
        --icon-color: #2f6fed;
        --icon-color-2: #6a93e0;
        --title-color: #0f2a52;
        --description-color: #3c5578;
        --data-color: #10233f;
        --subtitle-color: #5c7291;
    }

    /* 2. Carbono */
    .printCard.theme-carbono {
        --font-title: "Righteous", sans-serif;
        --bg-color: #1b1e24;
        --bg-img: #2a2e37;
        --model-color: #a8c56a;
        --border-color: rgba(255, 255, 255, 0.2);
        --bg-footer: rgba(255, 255, 255, 0.06);
        --icon-color: #ff7a30;
        --icon-color-2: #c95d20;
        --title-color: #f4f4f2;
        --description-color: #b7bac2;
        --data-color: #f1f1ef;
        --subtitle-color: #8a8e98;
    }

    .printCard.theme-carbono h3 {
        letter-spacing: 2px;
    }

    /* 3. Cobre */
    .printCard.theme-cobre {
        --font-title: "Merriweather", serif;
        --bg-color: #f6efe3;
        --bg-img: #ecdec4;
        --model-color: #66927d;
        --border-color: rgba(120, 80, 40, 0.25);
        --bg-footer: rgba(120, 80, 40, 0.1);
        --icon-color: #b5651d;
        --icon-color-2: #8a4a15;
        --title-color: #3c2410;
        --description-color: #6b4c30;
        --data-color: #2e1c0c;
        --subtitle-color: #8a7156;
    }

    /* 4. Matcha */
    .printCard.theme-matcha {
        --font-title: "Great Vibes", cursive;
        --bg-color: #eef3ea;
        --bg-img: #dbe6d3;
        --model-color: #c995a2;
        --border-color: rgba(60, 100, 50, 0.25);
        --bg-footer: rgba(60, 100, 50, 0.08);
        --icon-color: #4c7a3f;
        --icon-color-2: #7ba36a;
        --title-color: #1f3a18;
        --description-color: #47613c;
        --data-color: #142c0d;
        --subtitle-color: #6c8862;
    }

    /* 5. Neón */
    .printCard.theme-neon {
        --font-title: "Goldman", sans-serif;
        --bg-color: #0d0f1a;
        --bg-img: #1a1d2e;
        --model-color: #c7cc63;
        --border-color: rgba(255, 255, 255, 0.15);
        --bg-footer: rgba(255, 255, 255, 0.05);
        --icon-color: #37e6e6;
        --icon-color-2: #ff3fa4;
        --title-color: #f2f8ff;
        --description-color: #9fb4c9;
        --data-color: #e8fbff;
        --subtitle-color: #718aa3;
    }

    .printCard.theme-toy {
        --font-title: "Sriracha", cursive;

        --bg-color: #fff8df;
        --bg-img: #f5dfb0;

        --model-color: #4ecdc4;

        --border-color: rgba(220, 120, 90, 0.22);
        --bg-footer: rgba(220, 120, 90, 0.07);

        --icon-color: #d98b78;
        --icon-color-2: #7f9ac9;

        --title-color: #d46f5c;
        --description-color: #92756b;

        --data-color: #493b37;
        --subtitle-color: #b39b91;
    }

    .printCard.shadow {
        box-shadow: var(--shadow);
    }

    .printCard.border {
        border: var(--border);
    }
</style>
