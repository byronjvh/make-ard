---
import {
    ChevronDown,
    Menu,
    CircleUserRound,
    Boxes,
    GitBranch,
} from "@lucide/astro";
import GitHub from "./icons/GitHub.astro";
import GB from "./icons/GB.astro";
import ES from "./icons/ES.astro";
---

<header>
    <a href="/" class="logo-link">
        <p class="logo">Make-ard</p>
    </a>
    <nav>
        <div class="language-picker">
            <button id="language-button" class="language-selected">
                <span id="current-language">
                    <span id="flag-en" class="flag">
                        <GB size="22" />
                    </span>

                    <span id="flag-es" class="flag hide">
                        <ES size="22" />
                    </span>
                </span>
                <ChevronDown class="arrow" size={22} /></button
            >
            <div id="language-menu" class="language-menu">
                <button type="button" data-language="en"
                    >English <GB size="20" /></button
                >
                <button type="button" data-language="es"
                    >Español <ES size="20" /></button
                >
            </div>
        </div>
        <div class="menu-container">
            <button class="menu-button"><Menu size={18} /></button>
            <div class="menu-dropdown">
                <a class="nav-link disabled" href="#">
                    <span class="nav-icon">
                        <Boxes size={23} />
                    </span>
                    Suite</a
                >

                <a
                    rel="noopener noreferrer"
                    target="_blank"
                    class="nav-link"
                    href="https://github.com/byronjvh/make-ard"
                >
                    <span class="nav-icon">
                        <GitBranch size={23} />
                    </span>
                    <span data-i18n="repository">Repositorio</span>
                </a>
                <a
                    class="nav-link"
                    rel="noopener noreferrer"
                    target="_blank"
                    href="https://github.com/byronjvh"
                >
                    <span class="nav-icon">
                        <GitHub size="20" />
                    </span>
                    byronjvh
                </a>
            </div>
        </div>
    </nav>
</header>

<style>
    header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        width: 100%;
        padding: 16px 4px;
        max-width: 1000px;
        color: var(--ink);
    }

    .language-picker {
        position: relative;
        min-height: 0;
        height: min-content;
    }
    .language-picker button {
        font-family: "Google sans";
        font-size: 14px;
    }

    .language-selected {
        display: flex;
        border: none;
        background-color: var(--bg-elevated);
        padding: 4px 4px 4px 8px;
        border-radius: 8px;
        border: 1px solid color-mix(in srgb, var(--accent) 50%, transparent);
        align-items: center;
        gap: 4px;
        font-family: "Google sans";
        font-weight: 700;
        font-size: 16px;
        transition: background 0.15s ease-out;
        cursor: pointer;
    }
    .language-selected:hover {
        background-color: var(--accent-soft);
    }
    .language-menu {
        position: absolute;
        display: flex;
        flex-direction: column;
        background-color: var(--bg-elevated);
        border-radius: 8px;
        padding: 4px;
        gap: 2px;
        right: 0;
        top: calc(100% + 2px);
        overflow: hidden;
        height: 0px;
        transform: scaleY(0);
        transform-origin: top;
        interpolate-size: allow-keywords;
        transition:
            height 0.15s ease-out,
            transform 0.15s ease-out;
    }
    .language-menu button {
        background-color: transparent;
        padding: 2px 4px;
        border-radius: 4px;
        cursor: pointer;
        display: flex;
        gap: 4px;
        justify-content: space-between;
        border: none;
    }
    .language-menu button:hover {
        background-color: var(--accent-soft);
    }

    .language-menu.open {
        height: auto;
        transform: scaleY(1);
    }

    .arrow {
        transition: transform 0.15s ease-out;
    }

    .language-picker:has(.language-menu.open) .arrow {
        transform: rotate(180deg);
    }

    .flag {
        display: flex;
    }

    .flag.hide {
        display: none;
    }

    .menu-container {
        position: relative;
    }

    .menu-dropdown {
        display: flex;
        gap: 26px;
    }

    .menu-button {
        border: none;
        background-color: var(--bg-elevated);
        padding: 8px;
        border-radius: 8px;
        display: none;
        align-items: center;
        justify-content: center;
        color: var(--ink);
        cursor: pointer;
    }

    nav {
        display: flex;
        gap: 26px;
        align-items: center;
        font-family: "Google Sans", sans-serif;
    }

    .nav-link {
        display: flex;
        align-items: center;
        gap: 8px;
        font-weight: 500;
        font-size: 16px;
        color: var(--ink);
        text-decoration: none;
        transition: color 0.15s ease-out;
    }
    .nav-link.disabled {
        color: var(--placeholder);
        cursor: pointer;
        pointer-events: none;
    }
    .nav-link:hover {
        color: var(--accent-dark);
    }
    .nav-link-container {
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .logo-link {
        text-decoration: none;
        color: var(--ink);
    }

    .logo {
        font-family: "Ubuntu sans", sans-serif;
        font-weight: bold;
        font-style: italic;
        font-size: 24px;
        letter-spacing: -1px;
    }
    @media screen and (max-width: 580px) {
        .nav-link-container {
            gap: 16px;

            flex-direction: column;
            align-items: start;
        }

        .menu-dropdown {
            flex-direction: column;
            position: absolute;
            right: 0;
            top: calc(100% + 4px);
            background-color: var(--bg-elevated);
            padding: 16px;
            border-radius: 8px;
            box-shadow: 0px 4px 8px 3px rgba(0, 0, 0, 0.05);
        }

        .menu-button {
            display: flex;
        }

        nav {
            gap: 16px;
        }
    }
</style>

<script>
    import { translations, type Language } from "../i18n/translations";

    const langButton =
        document.querySelector<HTMLButtonElement>("#language-button");

    const langMenu = document.querySelector<HTMLElement>("#language-menu");

    const currentLanguage =
        document.querySelector<HTMLElement>("#current-language");

    const flagEn = document.querySelector("#flag-en");

    const flagEs = document.querySelector("#flag-es");

    let langOpen = false;

    const updateCropOptions = (language: Language) => {
        const select =
            document.querySelector<HTMLSelectElement>("#crop-select");

        if (!select) return;

        select.querySelector('[data-i18n="crops.cover"]')!.textContent =
            translations[language].crops.cover;

        select.querySelector('[data-i18n="crops.contain"]')!.textContent =
            translations[language].crops.contain;
    };

    const setLanguage = (language: Language) => {
        const texts = translations[language];

        document
            .querySelectorAll<HTMLElement>("[data-i18n]")
            .forEach((element) => {
                const key = element.dataset.i18n;
                if (!key) return;

                const value = texts[key as keyof typeof texts];

                if (typeof value !== "string") return;

                if (
                    element instanceof HTMLInputElement ||
                    element instanceof HTMLTextAreaElement
                ) {
                    element.placeholder = value;
                } else {
                    element.textContent = value;
                }
            });

        // options dinámicos
        updateSelectTranslations(language);
        updateCropOptions(language);

        // bandera
        flagEn?.classList.toggle("hide", language !== "en");
        flagEs?.classList.toggle("hide", language !== "es");

        localStorage.setItem("language", language);
    };

    const getInitialLanguage = (): Language => {
        const savedLanguage = localStorage.getItem("language");

        if (savedLanguage === "en" || savedLanguage === "es") {
            return savedLanguage;
        }

        return navigator.language.startsWith("es") ? "es" : "en";
    };

    const closeLanguageMenu = () => {
        langOpen = false;

        langMenu?.classList.remove("open");
        langButton?.setAttribute("aria-expanded", "false");
    };

    langButton?.addEventListener("click", (event) => {
        event.stopPropagation();

        langOpen = !langOpen;

        langMenu?.classList.toggle("open", langOpen);
        langButton.setAttribute("aria-expanded", String(langOpen));
    });

    langMenu?.addEventListener("click", (event) => {
        const target = event.target as HTMLElement;

        const languageButton =
            target.closest<HTMLButtonElement>("[data-language]");

        if (!languageButton) return;

        const language = languageButton.dataset.language;

        if (language === "en" || language === "es") {
            setLanguage(language);
        }

        closeLanguageMenu();
    });

    document.addEventListener("click", (event) => {
        const target = event.target as Node;

        if (!langButton?.contains(target) && !langMenu?.contains(target)) {
            closeLanguageMenu();
        }
    });

    const initialLanguage = getInitialLanguage();

    setLanguage(initialLanguage);

    function updateSelectTranslations(language: Language) {
        const texts = translations[language];

        document
            .querySelectorAll<HTMLOptionElement>("option[data-i18n-group]")
            .forEach((option) => {
                const group = option.dataset.i18nGroup;
                const key = option.dataset.i18nKey;

                if (!group || !key) return;

                const dictionary = texts[group as keyof typeof texts];

                if (!dictionary || typeof dictionary !== "object") {
                    return;
                }

                const translation = dictionary[key as keyof typeof dictionary];

                if (translation) {
                    option.textContent = translation;
                }
            });
    }
</script>
