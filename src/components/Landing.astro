---
import GCodeViewer from "./GCodeViewer.astro";
import PrintCard from "./PrintCard.astro";
import GitHub from "./icons/Github.astro";
---

<div id="container">
	<header>
		<a href="/" class="logo-link">
			<p class="logo">Make-ard</p>
		</a>
		<nav>
			<a class="nav-link" href="#">Acerca de</a>
			<a class="nav-link" href="#"><GitHub />byronjvh</a>
		</nav>
	</header>
	<h1 class="landing-title">
		Tu impresora hace la pieza, make-ard hace la ficha
	</h1>
	<p class="landing-tagline">
		Genera cards con los datos de tu modelo en segundos, elige un theme y
		compártelas donde quieras
	</p>
	<GCodeViewer />
	<section class="printCard-container">
		<PrintCard />
	</section>
	<div id="controls" class="controls hide">
		<div class="selec-wrapper">
			<label for="view-select">Vista</label>
			<select name="view" id="view-select"> </select>
		</div>
		<div class="selec-wrapper">
			<label for="zoom-select">Zoom</label>
			<select name="zoom" id="zoom-select"> </select>
		</div>
	</div>
</div>

<style>
	* {
		margin: 0;
		padding: 0;
		box-sizing: border-box;
	}

	header {
		display: flex;
		justify-content: space-between;
		align-items: center;
		width: 100%;
		padding: 16px 32px;
		max-width: 1000px;
	}

	nav {
		display: flex;
		gap: 16px;
		align-items: center;
	}

	.nav-link {
		display: flex;
		align-items: center;
		gap: 4px;
		font-family: "Google Sans", sans-serif;
		font-weight: 500;
		font-size: 16px;
		color: #333;
		text-decoration: none;
	}

	.logo-link {
		text-decoration: none;
		color: #333;
	}

	.logo {
		font-family: "Ubuntu sans", sans-serif;
		font-weight: bold;
		font-style: italic;
		font-size: 24px;
		letter-spacing: -1px;
	}

	#container {
		width: 100svw;
		max-width: 100svw;
		display: flex;
		align-items: center;
		flex-direction: column;
	}

	.printCard-container {
		width: 100%;
		max-width: 900px;
		display: flex;
	}

	.landing-title {
		font-family: "Ubuntu sans", sans-serif;
		font-weight: 900;
		font-size: 40px;
		max-width: 720px;
		text-align: center;
		text-wrap: balance;
		margin-block: 8px;
	}

	.landing-tagline {
		color: #666;
		font-family: "Google sans", sans-serif;
		font-size: 20px;
		max-width: 720px;
		text-align: center;
		text-wrap: pretty;
		margin-bottom: 28px;
	}

	.controls.hide {
		display: none;
	}

	.controls {
		width: 100%;
		max-width: 900px;
		display: flex;
		gap: 16px;
		margin-top: 8px;
	}

	.selec-wrapper {
		display: flex;
		align-items: center;
		gap: 4px;
	}
	/* un estilo muy bonito para los selectores y las options */
	.selec-wrapper label {
		font-family: "Google Sans", sans-serif;
		font-size: 16px;
		font-weight: 500;
		color: #333;
	}

	.selec-wrapper select {
		padding: 4px 8px;
		border-radius: 4px;
		border: 1px solid #ccc;
		font-family: "Google Sans", sans-serif;
		font-size: 14px;
		font-weight: 500;
		background-color: #fff;
		color: #333;
	}
</style>

<script>
	const dictionaryAngles = {
		isoFL: "Isometric FL",
		isoFR: "Isometric FR",
		isoBL: "Isometric BL",
		isoBR: "Isometric BR",
		top: "Top",
		front: "Front",
		left: "Left",
		right: "Right",
		back: "Back",
	};
	import { cameraAnglesOptions } from "../logic/camera";
	import { zoomOptions } from "../logic/camera";
	for (const zoom of zoomOptions) {
		const option = document.createElement("option");
		option.value = zoom;
		option.textContent = zoom;
		document?.getElementById("zoom-select")?.appendChild(option);
	}
	for (const angle of cameraAnglesOptions) {
		const option = document.createElement("option");
		option.value = angle;
		option.textContent = dictionaryAngles[angle] || angle;
		document?.getElementById("view-select")?.appendChild(option);
	}
</script>
