---
import GCodeViewer from "./GCodeViewer.astro";
import PrintCard from "./PrintCard.astro";
import GitHub from "./icons/GitHub.astro";
import { ImagePlus } from "@lucide/astro";
---

<div id="container">
	<header>
		<a href="/" class="logo-link">
			<p class="logo">Make-ard</p>
		</a>
		<nav>
			<a class="nav-link" href="#">Acerca de</a>
			<a class="nav-link" href="#"><GitHub size="18" />byronjvh</a>
		</nav>
	</header>
	<span class="landing-top-separator"></span>
	<h1 class="landing-title">
		Tu impresora hace la pieza, make-ard hace la ficha
	</h1>
	<p class="landing-tagline">
		Genera cards con los datos de tu modelo en segundos, elige un theme y
		compártelas donde quieras
	</p>
	<GCodeViewer />
	<section class="printCard-container hide">
		<div>
			<div class="printCard-area">
				<PrintCard />
			</div>
			<div id="controls" class="controls">
				<div class="selec-wrapper">
					<label for="view-select">Vista</label>
					<select name="view" id="view-select"> </select>
				</div>
				<div class="selec-wrapper">
					<label for="zoom-select">Zoom</label>
					<select name="zoom" id="zoom-select"> </select>
				</div>
				<div class="selec-wrapper">
					<label for="crop-select">Crop</label>
					<select name="theme" id="crop-select">
						<option value="cover">Cover</option>
						<option value="contain">Preserve</option>
					</select>
				</div>
				<div class="selec-wrapper">
					<label for="theme-select">Tema</label>
					<select name="theme" id="theme-select"> </select>
				</div>
				<div class="selec-wrapper">
					<label for="shadow-input">Shadow</label>
					<input
						type="checkbox"
						checked
						name="shadow"
						id="shadow-input"
					/>
				</div>
				<div class="selec-wrapper">
					<label for="border-select">Border</label>
					<input type="checkbox" name="border" id="border-input" />
				</div>
			</div>
		</div>
		<form id="print-card-form" class="printCard-form">
			<span class="corner tl"></span>
			<span class="corner br"></span>

			<h3>DATOS DEL MODELO</h3>

			<div class="printCard-form-row">
				<div class="printCard-form-field title">
					<label for="modelName">Nombre del modelo</label>
					<input
						id="modelName"
						name="modelName"
						type="text"
						required="true"
						placeholder="Ej. Dinosaurio 3D"
					/>
				</div>
				<div class="printCard-form-field changeFile">
					<button class="changeFile-button">
						<p class="changeFile-text">nombre_del_archivo.svg</p>
						<span class="changeFile-icon-wrapper">
							<ImagePlus size={18} />
						</span>
					</button>
				</div>
			</div>

			<div class="printCard-form-field">
				<label for="description">Descripción del modelo</label>
				<input
					id="description"
					name="description"
					type="text"
					required="true"
					placeholder="Ej. Juguete infantil de dinosaurio, impreso en 3D"
				/>
			</div>

			<div class="printCard-form-row">
				<div class="printCard-form-field">
					<label for="printTime">Print Time</label>
					<input
						id="printTime"
						name="printTime"
						type="text"
						required="true"
						placeholder="1h 45m"
					/>
				</div>

				<div class="printCard-form-field">
					<label for="filamentUsed">Filament Used</label>
					<input
						id="filamentUsed"
						name="filamentUsed"
						type="text"
						required="true"
						placeholder="90g"
					/>
				</div>

				<div class="printCard-form-field">
					<label for="dimensions">Dimensions</label>
					<input
						id="dimensions"
						name="dimensions"
						type="text"
						required="true"
						placeholder="120x90x180 mm"
					/>
				</div>
			</div>

			<div class="printCard-form-row">
				<div class="printCard-form-field">
					<label for="layerHeight">Layer Height</label>
					<input
						id="layerHeight"
						name="layerHeight"
						type="text"
						required="true"
						placeholder="0.20 mm"
					/>
				</div>

				<div class="printCard-form-field">
					<label for="infill">Infill</label>
					<input
						id="infill"
						name="infill"
						type="text"
						required="true"
						placeholder="15%"
					/>
				</div>

				<div class="printCard-form-field">
					<label for="walls">Walls</label>
					<input
						id="walls"
						name="walls"
						type="text"
						required="true"
						placeholder="3"
					/>
				</div>
			</div>

			<div class="printCard-form-row">
				<div class="printCard-form-field">
					<label for="material">Material</label>
					<input
						id="material"
						name="material"
						type="text"
						required="true"
						placeholder="PLA"
					/>
				</div>

				<div class="printCard-form-field">
					<label for="nozzleDiameter">Nozzle</label>
					<input
						id="nozzleDiameter"
						name="nozzleDiameter"
						type="text"
						required="true"
						placeholder="0.4 mm"
					/>
				</div>

				<div class="printCard-form-field">
					<label for="supports">Supports</label>
					<input
						id="supports"
						name="supports"
						type="text"
						required="true"
						placeholder="Yes"
					/>
				</div>
			</div>

			<div class="printCard-form-row">
				<div class="printCard-form-field">
					<label for="printer">Printer</label>
					<input
						id="printer"
						name="printer"
						type="text"
						required="true"
						placeholder="Flashforge AD5X"
					/>
				</div>

				<div class="printCard-form-field">
					<label for="signature">Signature</label>
					<input
						id="signature"
						name="signature"
						type="text"
						required="true"
						placeholder="username"
					/>
				</div>
			</div>

			<button class="printCard-form-download" type="submit"
				>Descargar Print Card</button
			>
		</form>
	</section>
</div>

<style>
	header {
		display: flex;
		justify-content: space-between;
		align-items: center;
		width: 100%;
		padding: 16px 32px;
		max-width: 1000px;
	}

	nav {
		display: flex;
		gap: 22px;
		align-items: center;
	}

	.nav-link {
		display: flex;
		align-items: center;
		gap: 8px;
		font-family: "Google Sans", sans-serif;
		font-weight: 500;
		font-size: 16px;
		color: #333;
		text-decoration: none;
	}

	.logo-link {
		text-decoration: none;
		color: var(--ink);
	}

	.logo {
		font-family: "Ubuntu sans", sans-serif;
		font-weight: bold;
		font-style: italic;
		font-size: 24px;
		letter-spacing: -1px;
	}

	#container {
		width: 100svw;
		max-width: 100svw;
		display: flex;
		align-items: center;
		flex-direction: column;
	}

	.landing-top-separator {
		width: 50px;
		height: 4px;
		background-color: var(--accent-dark);
		margin: 64px 0 12px;
	}

	.printCard-container {
		width: 100%;
		max-width: 1000px;
		display: flex;
		gap: 16px;
	}

	.landing-title {
		font-family: "Ubuntu sans", sans-serif;
		font-weight: 900;
		font-size: 48px;
		max-width: 720px;
		text-align: center;
		text-wrap: balance;
		margin-block: 16px;
		color: var(--ink);
	}

	.landing-tagline {
		color: var(--muted);
		font-family: "Google sans", sans-serif;
		font-size: 18px;
		max-width: 680px;
		text-align: center;
		text-wrap: pretty;
		margin-bottom: 48px;
	}

	.controls {
		width: 100%;
		max-width: 1000px;
		display: flex;
		gap: 12px;
		margin-top: 8px;
		flex-wrap: wrap;
	}

	.selec-wrapper {
		display: flex;
		align-items: center;
		gap: 4px;
	}
	.selec-wrapper:has(select.hide) {
		display: none;
	}
	/* un estilo muy bonito para los selectores y las options */
	.selec-wrapper label {
		font-family: "Google Sans", sans-serif;
		font-size: 14px;
		font-weight: 500;
		color: #333;
	}

	.selec-wrapper select {
		padding: 4px 4px;
		border-radius: 4px;
		border: 1px solid #ccc;
		font-family: "Google Sans", sans-serif;
		font-size: 14px;
		font-weight: 500;
		background-color: #fff;
		color: #333;
	}

	.printCard-area {
		background-color: var(--bg-elevated);
		border-radius: 6px;
		width: calc(
			var(--card-width) * var(--card-scale) + var(--wrapper-padding) * 2
		);

		height: calc(
			var(--card-height) * var(--card-scale) + var(--wrapper-padding) * 2
		);

		padding: var(--wrapper-padding);
	}

	.printCard-form {
		position: relative;
		display: flex;
		flex-direction: column;
		gap: 16px;
		background-color: var(--bg-elevated);
		padding: 20px;
		border-radius: 6px;
	}
	.printCard-form-download {
		border: none;
		border-radius: 8px;
		padding: 10px;
		font-weight: 700;
		color: #fff;
		background-color: var(--accent);
		font-family: "Google sans", sans-serif;
		cursor: pointer;
		transition: background 0.15s ease-out;
	}
	.printCard-form-download:hover {
		background-color: var(--accent-dark);
	}
	.printCard-form h3 {
		font-size: 14px;
		font-family: "Ubuntu sans", sans-serif;
		color: var(--accent-dark);
	}

	.printCard-form-field {
		display: flex;
		flex-direction: column;
		gap: 4px;
		font-size: "Google sans", sans-serif;
	}
	.printCard-form-field.changeFile {
		width: max-content;
		display: flex;
		justify-content: end;
		max-width: 154px;
	}
	.changeFile-button {
		border: none;
		background-color: transparent;
		font-size: 12px;
		display: flex;
		align-items: center;
		cursor: pointer;
		gap: 2px;
		padding-bottom: 1px;
		border-bottom: 1px solid var(--accent-dark);
	}

	.changeFile-icon-wrapper {
		color: var(--accent-dark);
	}
	.printCard-form-field label {
		color: var(--muted);
		font-size: 14px;
	}
	.printCard-form-field.title {
		flex: 1;
	}

	.printCard-form-field input {
		border-radius: 8px;
		border: 1px solid var(--placeholder);
		font-size: 13px;
		padding: 8px;
		width: 100%;
	}

	.printCard-form-row {
		display: flex;
		gap: 16px;
	}

	.printCard-form > * {
		position: relative;
		z-index: 1;
	}

	.printCard-form .corner {
		position: absolute;
		width: 26px;
		height: 26px;
		z-index: 0;
		border-color: var(--accent-dark);
		border-style: solid;
		--border-width: 3px;
	}

	.printCard-form .corner.tl {
		border-top-left-radius: inherit;
		left: 0;
		top: 0;
		border-width: var(--border-width) 0px 0px var(--border-width);
	}

	.printCard-form .corner.br {
		border-bottom-right-radius: inherit;
		right: 0;
		bottom: 0;
		border-width: 0px var(--border-width) var(--border-width) 0px;
	}

	.printCard-container.hide {
		display: none;
	}
</style>

<script>
	const dictionaryAngles = {
		isoFL: "Isometric FL",
		isoFR: "Isometric FR",
		isoBL: "Isometric BL",
		isoBR: "Isometric BR",
		top: "Top",
		front: "Front",
		left: "Left",
		right: "Right",
		back: "Back",
		bottom: "Bottom",
	};
	import { cameraAnglesOptions } from "../logic/camera";
	import { zoomOptions } from "../logic/camera";
	import { dictionaryThemes, THEMES } from "../logic/themes";
	import { printCardState } from "../logic/printCardState";
	import { setupPrintCardForm } from "../logic/setupPrintCardForm";
	import {
		formatMetadata,
		type FormattedPrintCardMetadata,
	} from "../logic/formatMetadata";
	import html2canvas from "html2canvas";
	let hasShadow = true;
	const printCard = document.querySelector<HTMLElement>(".printCard");
	const printCardImg = document.querySelector<HTMLImageElement>(
		".printCard-thumbnail",
	);
	const form = document.querySelector<HTMLFormElement>("#print-card-form");
	const cropSelect =
		document.querySelector<HTMLSelectElement>("#crop-select");
	form?.addEventListener("submit", async (e) => {
		e.preventDefault();

		if (!printCard) return;
		await document.fonts.ready;
		const canvas = await html2canvas(printCard, {
			useCORS: true,
			scale: 1,
			backgroundColor: null,
		});

		let finalCanvas = canvas;

		if (hasShadow) {
			const shadowCanvas = await createShadowCanvas(canvas);

			if (!shadowCanvas) return;

			finalCanvas = shadowCanvas;
		}

		const link = document.createElement("a");

		link.download = "printcard.png";
		link.href = finalCanvas.toDataURL("image/png");

		link.click();
	});
	for (const zoom of zoomOptions) {
		const option = document.createElement("option");
		option.value = zoom;
		option.textContent = zoom;
		document?.getElementById("zoom-select")?.appendChild(option);
	}
	for (const angle of cameraAnglesOptions) {
		const option = document.createElement("option");
		option.value = angle;
		option.textContent = dictionaryAngles[angle] || angle;
		document?.getElementById("view-select")?.appendChild(option);
	}

	for (const theme of THEMES) {
		const option = document.createElement("option");
		option.value = theme;
		option.textContent = dictionaryThemes[theme] || theme;
		document?.getElementById("theme-select")?.appendChild(option);
		document
			?.getElementById("theme-select")
			?.addEventListener("change", (event) => {
				const selectedTheme = (event.target as HTMLSelectElement).value;
				if (!printCard) return;
				printCard.classList.remove(...THEMES);
				printCard.classList.add(selectedTheme);
			});
	}

	window.addEventListener("print-card-metadata-ready", () => {
		const { printCardMetadata } = printCardState;

		if (!printCardMetadata) return;
		fillPrintCardForm(formatMetadata(printCardMetadata));
	});

	const shadowInput = document.getElementById(
		"shadow-input",
	) as HTMLInputElement;

	const borderInput = document.getElementById(
		"border-input",
	) as HTMLInputElement;

	shadowInput.addEventListener("change", () => {
		if (shadowInput.checked) {
			printCard?.classList.add("shadow");
			hasShadow = true;
		} else {
			printCard?.classList.remove("shadow");
			hasShadow = false;
		}
	});
	borderInput.addEventListener("change", () => {
		if (borderInput.checked) {
			printCard?.classList.add("border");
		} else {
			printCard?.classList.remove("border");
		}
	});
	cropSelect?.addEventListener("change", (event) => {
		const select = event.currentTarget as HTMLSelectElement;
		const selectedValue = select.value;

		if (!selectedValue || !printCardImg) return;

		printCardImg.style.objectFit = selectedValue;
	});

	function fillPrintCardForm(metadata: FormattedPrintCardMetadata) {
		if (!form) return;

		for (const [key, value] of Object.entries(metadata)) {
			const input = form.elements.namedItem(key);

			if (input instanceof HTMLInputElement) {
				input.value = value ?? "";
			}
		}
	}

	async function createShadowCanvas(cardCanvas: HTMLCanvasElement) {
		const padding = 20;

		const shadowCanvas = document.createElement("canvas");

		shadowCanvas.width = cardCanvas.width + padding * 2;
		shadowCanvas.height = cardCanvas.height + padding * 2;

		const ctx = shadowCanvas.getContext("2d");

		if (!ctx) return null;

		ctx.save();

		ctx.shadowColor = "rgba(0, 0, 0, 0.1)";
		ctx.shadowBlur = 12;
		ctx.shadowOffsetX = 0;
		ctx.shadowOffsetY = 6;

		ctx.drawImage(cardCanvas, padding, padding);

		ctx.restore();

		ctx.drawImage(cardCanvas, padding, padding);

		return shadowCanvas;
	}

	if (form) {
		setupPrintCardForm(form);
	}
</script>
