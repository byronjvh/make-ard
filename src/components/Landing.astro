---
import GCodeViewer from "./GCodeViewer.astro";
import PrintCard from "./PrintCard.astro";
import GitHub from "./icons/GitHub.astro";
---

<div id="container">
	<header>
		<a href="/" class="logo-link">
			<p class="logo">Make-ard</p>
		</a>
		<nav>
			<a class="nav-link" href="#">Acerca de</a>
			<a class="nav-link" href="#"><GitHub size="18" />byronjvh</a>
		</nav>
	</header>
	<span class="landing-top-separator"></span>
	<h1 class="landing-title">
		Tu impresora hace la pieza, make-ard hace la ficha
	</h1>
	<p class="landing-tagline">
		Genera cards con los datos de tu modelo en segundos, elige un theme y
		compártelas donde quieras
	</p>
	<GCodeViewer />
	<section class="printCard-container">
		<PrintCard />
		<form action="">
			<div>
				<div>
					<label for="">Print Time</label>
					<input type="number" />
				</div>
				<div>
					<label for="">Filament Used</label>
					<input type="text" />
				</div>
				<div>
					<label for="">Dimensions</label>
					<input type="text" />
				</div>
			</div>
			<div>
				<div>
					<label for="">Layer Height</label>
					<input type="number" />
				</div>
				<div>
					<label for="">Infill</label>
					<input type="text" />
				</div>
				<div>
					<label for="">Walls</label>
					<input type="text" />
				</div>
			</div>
			<div>
				<div>
					<label for="">Material</label>
					<input type="number" />
				</div>
				<div>
					<label for="">Nozzle</label>
					<input type="text" />
				</div>
				<div>
					<label for="">Supports</label>
					<input type="text" />
				</div>
			</div>
		</form>
	</section>
	<div id="controls" class="controls hide">
		<div class="selec-wrapper">
			<label for="view-select">Vista</label>
			<select name="view" id="view-select"> </select>
		</div>
		<div class="selec-wrapper">
			<label for="zoom-select">Zoom</label>
			<select name="zoom" id="zoom-select"> </select>
		</div>
		<div class="selec-wrapper">
			<label for="theme-select">Tema</label>
			<select name="theme" id="theme-select"> </select>
		</div>
	</div>
</div>

<style>
	header {
		display: flex;
		justify-content: space-between;
		align-items: center;
		width: 100%;
		padding: 16px 32px;
		max-width: 1000px;
	}

	nav {
		display: flex;
		gap: 22px;
		align-items: center;
	}

	.nav-link {
		display: flex;
		align-items: center;
		gap: 8px;
		font-family: "Google Sans", sans-serif;
		font-weight: 500;
		font-size: 16px;
		color: #333;
		text-decoration: none;
	}

	.logo-link {
		text-decoration: none;
		color: var(--ink);
	}

	.logo {
		font-family: "Ubuntu sans", sans-serif;
		font-weight: bold;
		font-style: italic;
		font-size: 24px;
		letter-spacing: -1px;
	}

	#container {
		width: 100svw;
		max-width: 100svw;
		display: flex;
		align-items: center;
		flex-direction: column;
	}

	.landing-top-separator {
		width: 50px;
		height: 4px;
		background-color: var(--accent-dark);
		margin: 64px 0 12px;
	}

	.printCard-container {
		width: 100%;
		max-width: 900px;
		display: flex;
	}

	.landing-title {
		font-family: "Ubuntu sans", sans-serif;
		font-weight: 900;
		font-size: 48px;
		max-width: 720px;
		text-align: center;
		text-wrap: balance;
		margin-block: 16px;
		color: var(--ink);
	}

	.landing-tagline {
		color: var(--muted);
		font-family: "Google sans", sans-serif;
		font-size: 18px;
		max-width: 680px;
		text-align: center;
		text-wrap: pretty;
		margin-bottom: 48px;
	}

	.controls.hide {
		display: none;
	}

	.controls {
		width: 100%;
		max-width: 900px;
		display: flex;
		gap: 16px;
		margin-top: 8px;
	}

	.selec-wrapper {
		display: flex;
		align-items: center;
		gap: 4px;
	}
	/* un estilo muy bonito para los selectores y las options */
	.selec-wrapper label {
		font-family: "Google Sans", sans-serif;
		font-size: 16px;
		font-weight: 500;
		color: #333;
	}

	.selec-wrapper select {
		padding: 4px 8px;
		border-radius: 4px;
		border: 1px solid #ccc;
		font-family: "Google Sans", sans-serif;
		font-size: 14px;
		font-weight: 500;
		background-color: #fff;
		color: #333;
	}
</style>

<script>
	import { formatMetadata } from "../logic/formatMetadata";
	import type { PrintCardMetadata } from "../logic/extractPrintCardMetadata";

	const dictionaryAngles = {
		isoFL: "Isometric FL",
		isoFR: "Isometric FR",
		isoBL: "Isometric BL",
		isoBR: "Isometric BR",
		top: "Top",
		front: "Front",
		left: "Left",
		right: "Right",
		back: "Back",
		bottom: "Bottom",
	};
	import { cameraAnglesOptions } from "../logic/camera";
	import { zoomOptions } from "../logic/camera";
	import { dictionaryThemes, THEMES } from "../logic/themes";
	import { printCardState } from "../logic/printCardState";
	for (const zoom of zoomOptions) {
		const option = document.createElement("option");
		option.value = zoom;
		option.textContent = zoom;
		document?.getElementById("zoom-select")?.appendChild(option);
	}
	for (const angle of cameraAnglesOptions) {
		const option = document.createElement("option");
		option.value = angle;
		option.textContent = dictionaryAngles[angle] || angle;
		document?.getElementById("view-select")?.appendChild(option);
	}

	for (const theme of THEMES) {
		const option = document.createElement("option");
		option.value = theme;
		option.textContent = dictionaryThemes[theme] || theme;
		document?.getElementById("theme-select")?.appendChild(option);
		document
			?.getElementById("theme-select")
			?.addEventListener("change", (event) => {
				const selectedTheme = (event.target as HTMLSelectElement).value;
				const printCard = document.getElementById("print-card");
				if (!printCard) return;
				printCard.classList.remove(...THEMES);
				printCard.classList.add(selectedTheme);
			});
	}

	window.addEventListener("print-card-state-ready", () => {
		const { printCardMetadata } = printCardState;

		if (!printCardMetadata) return;

		console.log(printCardMetadata);
	});
</script>
