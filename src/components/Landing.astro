---
import BenchyLoader from "./BenchyLoader.astro";
import GCodeViewer from "./GCodeViewer.astro";
import Header from "./Header.astro";
import PrintCard from "./PrintCard.astro";
import { FileImage, RefreshCw } from "@lucide/astro";
import Support from "./Support.astro";
import Footer from "./Footer.astro";
---

<div id="container">
	<Header />
	<span class="landing-top-separator"></span>
	<h1 class="landing-title">
		<span data-i18n="titleStart">Your printer makes the part;</span>
		<span class="landing-title-brand"> make-ard </span>
		<span data-i18n="titleEnd">makes the Print Card</span>
	</h1>
	<p data-i18n="description" class="landing-tagline">
		Create cards with your model's data in seconds, choose a theme, and
		share them wherever you want
	</p>
	<GCodeViewer />
	<section class="printCard-container hide">
		<div>
			<div id="printCard-area" class="printCard-area">
				<PrintCard />
			</div>
			<div id="controls" class="controls">
				<div class="selec-wrapper">
					<label data-i18n="view" for="view-select">View</label>
					<select name="view" id="view-select"> </select>
				</div>
				<div class="selec-wrapper">
					<label data-i18n="zoom" for="zoom-select">Zoom</label>
					<select name="zoom" id="zoom-select"> </select>
				</div>
				<div class="selec-wrapper">
					<label data-i18n="crop" for="crop-select">Crop</label>
					<select name="theme" id="crop-select">
						<option data-i18n="crops.cover" value="cover"
							>Cover</option
						>
						<option data-i18n="crops.contain" value="contain"
							>Preserve</option
						>
					</select>
				</div>
				<div class="selec-wrapper">
					<label data-i18n="theme" for="theme-select">Theme</label>
					<select name="theme" id="theme-select"> </select>
				</div>
				<div class="selec-wrapper checkbox">
					<label data-i18n="shadow" for="shadow-input">Shadow</label>
					<input
						type="checkbox"
						checked
						name="shadow"
						id="shadow-input"
					/>
				</div>
				<div class="selec-wrapper checkbox">
					<label data-i18n="border" for="border-input">Border</label>
					<input type="checkbox" name="border" id="border-input" />
				</div>
			</div>
		</div>
		<form id="print-card-form" class="printCard-form">
			<span class="corner tl"></span>
			<span class="corner br"></span>

			<h3 data-i18n="formTitle">MODEL DATA</h3>

			<div class="printCard-form-row">
				<div class="printCard-form-field title">
					<label data-i18n="formName" for="modelName"
						>Model name</label
					>
					<input
						id="modelName"
						name="modelName"
						type="text"
						required="true"
						placeholder="Ej. Dinosaurio 3D"
					/>
				</div>
				<div class="printCard-form-field changeFile">
					<label data-i18n="formFile" for="changeFile-button"
						>File</label
					>
					<button
						type="button"
						id="changeFile-button"
						class="changeFile-button"
					>
						<p class="changeFile-text">
							<FileImage size={16} />
							<span id="fileName-text-button">
								file_name.svg
							</span>
						</p>
						<span class="changeFile-icon"
							><RefreshCw id="change-icon" size={18} />
							<BenchyLoader
								id="benchy-loader-form"
								size={22}
								class="benchy-loader-form"
							/>
						</span>
					</button>
				</div>
			</div>

			<div class="printCard-form-field">
				<label data-i18n="formDescription" for="description"
					>Model description</label
				>
				<input
					data-i18n="formDescriptionPlaceholder"
					id="description"
					name="description"
					type="text"
					required="true"
					placeholder="Ej. Juguete infantil de dinosaurio, impreso en 3D"
				/>
			</div>

			<div class="printCard-form-row">
				<div class="printCard-form-field">
					<label data-i18n="formTime" for="printTime"
						>Print Time</label
					>
					<input
						id="printTime"
						name="printTime"
						type="text"
						required="true"
						placeholder="1h 45m"
					/>
				</div>

				<div class="printCard-form-field">
					<label data-i18n="formFilament" for="filamentUsed"
						>Filament Used</label
					>
					<input
						id="filamentUsed"
						name="filamentUsed"
						type="text"
						required="true"
						placeholder="90g"
					/>
				</div>

				<div class="printCard-form-field">
					<label data-i18n="dimensions" for="dimensions"
						>Dimensions</label
					>
					<input
						id="dimensions"
						name="dimensions"
						type="text"
						required="true"
						placeholder="120x90x180 mm"
					/>
				</div>
			</div>

			<div class="printCard-form-row">
				<div class="printCard-form-field">
					<label data-i18n="layerHeight" for="layerHeight"
						>Layer Height</label
					>
					<input
						id="layerHeight"
						name="layerHeight"
						type="text"
						required="true"
						placeholder="0.20 mm"
					/>
				</div>

				<div class="printCard-form-field">
					<label data-i18n="formInfill" for="infill">Infill</label>
					<input
						id="infill"
						name="infill"
						type="text"
						required="true"
						placeholder="15%"
					/>
				</div>

				<div class="printCard-form-field">
					<label data-i18n="formWalls" for="walls">Walls</label>
					<input
						id="walls"
						name="walls"
						type="text"
						required="true"
						placeholder="3"
					/>
				</div>
			</div>

			<div class="printCard-form-row">
				<div class="printCard-form-field">
					<label data-i18n="material" for="material">Material</label>
					<input
						id="material"
						name="material"
						type="text"
						required="true"
						placeholder="PLA"
					/>
				</div>

				<div class="printCard-form-field">
					<label data-i18n="formNozzle" for="nozzleDiameter"
						>Nozzle</label
					>
					<input
						id="nozzleDiameter"
						name="nozzleDiameter"
						type="text"
						required="true"
						placeholder="0.4 mm"
					/>
				</div>

				<div class="printCard-form-field">
					<label data-i18n="formSupports" for="supports"
						>Supports</label
					>
					<input
						id="supports"
						name="supports"
						type="text"
						required="true"
						placeholder="Yes"
					/>
				</div>
			</div>

			<div class="printCard-form-row">
				<div class="printCard-form-field">
					<label data-i18n="formPrinter" for="printer">Printer</label>
					<input
						id="printer"
						name="printer"
						type="text"
						required="true"
						placeholder="Flashforge AD5X"
					/>
				</div>

				<div class="printCard-form-field">
					<label data-i18n="formPrinter" for="signature"
						>Signature</label
					>
					<input
						id="signature"
						name="signature"
						type="text"
						required="true"
						placeholder="username"
					/>
				</div>
			</div>

			<button
				data-i18n="formDownload"
				class="printCard-form-download"
				type="submit">Download Print Card</button
			>
		</form>
	</section>

	<Support />
	<Footer />
</div>

<style>
	#container {
		max-width: 100svw;
		display: flex;
		align-items: center;
		flex-direction: column;
	}

	.landing-top-separator {
		width: 50px;
		height: 4px;
		background-color: var(--accent-dark);
		margin: 64px 0 12px;
	}

	.printCard-container {
		width: 100%;
		max-width: 1000px;
		display: flex;
		gap: 16px;
		padding-bottom: 0;
	}

	.landing-title {
		font-family: "Ubuntu sans", sans-serif;
		font-weight: 900;
		font-size: 48px;
		max-width: 720px;
		text-align: center;
		text-wrap: balance;
		margin-block: 16px;
		color: var(--ink);
	}
	.landing-title-brand {
		text-wrap: nowrap;
	}

	.landing-tagline {
		color: var(--muted);
		font-family: "Google sans", sans-serif;
		font-size: 18px;
		max-width: 680px;
		text-align: center;
		text-wrap: pretty;
		margin-bottom: 48px;
	}

	.controls {
		width: 100%;
		max-width: 1000px;
		display: flex;
		gap: 12px;
		margin-top: 8px;
		flex-wrap: wrap;
	}

	.selec-wrapper {
		display: flex;
		align-items: center;
		gap: 4px;
	}
	.selec-wrapper:has(select.hide) {
		display: none;
	}
	/* un estilo muy bonito para los selectores y las options */
	.selec-wrapper label {
		font-family: "Google Sans", sans-serif;
		font-size: 14px;
		font-weight: 500;
		color: #333;
	}

	.selec-wrapper select {
		padding: 4px 4px;
		border-radius: 4px;
		border: 1px solid #ccc;
		font-family: "Google Sans", sans-serif;
		font-size: 14px;
		font-weight: 500;
		background-color: #fff;
		color: #333;
		cursor: pointer;
		transition: border 0.15s ease-out;
	}
	.selec-wrapper select:hover {
		border: 1px solid var(--accent);
	}

	.selec-wrapper.checkbox {
		cursor: pointer;
		color: var(--muted);
	}
	.selec-wrapper.checkbox label,
	.selec-wrapper.checkbox input {
		min-height: 30px;
		height: 100%;
		display: flex;
		align-items: center;
		cursor: inherit;
		transition: color 0.15s ease-out;
		color: inherit;
	}
	.selec-wrapper.checkbox:hover {
		color: var(--accent-dark);
	}

	.printCard-area {
		box-sizing: border-box;
		background-color: var(--bg-elevated);
		border-radius: 6px;
		width: calc(
			var(--card-width) * var(--card-scale) + var(--wrapper-padding) * 2
		);

		height: calc(
			var(--card-height) * var(--card-scale) + var(--wrapper-padding) * 2
		);

		padding: var(--wrapper-padding);
	}

	.printCard-form {
		position: relative;
		display: flex;
		flex-direction: column;
		gap: 16px;
		background-color: var(--bg-elevated);
		padding: 20px;
		border-radius: 6px;
		z-index: 99;
	}
	.printCard-form-download {
		border: none;
		border-radius: 8px;
		padding: 10px;
		font-weight: 700;
		color: #fff;
		background-color: var(--accent);
		font-family: "Google sans", sans-serif;
		cursor: pointer;
		transition: background 0.15s ease-out;
	}
	.printCard-form-download:hover {
		background-color: var(--accent-dark);
	}
	.printCard-form h3 {
		font-size: 14px;
		font-family: "Ubuntu sans", sans-serif;
		color: var(--accent-dark);
	}

	.printCard-form-field {
		display: flex;
		flex-direction: column;
		gap: 4px;
		font-size: "Google sans", sans-serif;
		flex: 1;
	}
	.changeFile-text {
		padding-inline: 4px;
		display: flex;
		color: var(--muted);
		align-items: center;
		max-width: 140px;
	}

	.changeFile-text span {
		min-width: 0;
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}
	.changeFile-button {
		border-radius: 8px;
		border: 1px solid var(--accent);
		font-size: 13px;
		height: 100%;
		max-height: 33px;
		width: 100%;
		display: flex;
		justify-content: space-between;
		align-items: center;
		cursor: pointer;
		background-color: #fff;
		transition: border 0.15s ease-out;
		overflow: hidden;
	}
	.changeFile-button:hover {
		border: 1px solid var(--accent-dark);
	}

	.changeFile-icon {
		position: relative;
		color: #fff;
		background-color: var(--accent);
		height: 100%;
		padding-inline: 6px;
		display: flex;
		align-items: center;
		transition: background 0.25s ease-out;
	}

	#change-icon.hide {
		visibility: hidden;
	}
	#benchy-loader-form.hide {
		visibility: hidden;
	}

	.changeFile-button:hover > .changeFile-icon {
		background-color: var(--accent-dark);
	}
	.printCard-form-field label {
		color: var(--muted);
		font-size: 14px;
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}
	.printCard-form-field.title {
		flex: 1;
	}

	.printCard-form-field input {
		border-radius: 8px;
		border: 1px solid var(--placeholder);
		font-size: 13px;
		padding: 8px;
		width: 100%;
	}

	.printCard-form-row {
		display: flex;
		gap: 16px;
	}

	.printCard-form > * {
		position: relative;
		z-index: 1;
	}

	.printCard-form .corner {
		position: absolute;
		width: 26px;
		height: 26px;
		z-index: 0;
		border-color: var(--accent-dark);
		border-style: solid;
		--border-width: 3px;
	}

	.printCard-form .corner.tl {
		border-top-left-radius: inherit;
		left: 0;
		top: 0;
		border-width: var(--border-width) 0px 0px var(--border-width);
	}

	.printCard-form .corner.br {
		border-bottom-right-radius: inherit;
		right: 0;
		bottom: 0;
		border-width: 0px var(--border-width) var(--border-width) 0px;
	}

	.printCard-container.hide {
		display: none;
	}

	.benchy-loader-form {
		position: absolute;
		left: 50%;
		top: 50%;
		transform: translate(-50%, -50%);
	}

	@media screen and (max-width: 580px) {
		.landing-title {
			font-size: 32px;
		}

		.landing-tagline {
			font-size: 16px;
		}

		.printCard-form-field label {
			font-size: 12px;
		}
		.printCard-form-field input {
			font-size: 12px;
		}

		.selec-wrapper label {
			font-size: 12px;
		}

		.selec-wrapper select {
			font-size: 12px;
		}
	}

	@media screen and (max-width: 980px) {
		.printCard-container {
			flex-direction: column;
			align-items: center;
		}

		.printCard-form {
			max-width: 480px;
		}
		.controls {
			max-width: 480px;
			justify-self: center;
		}
	}
</style>

<script>
	const dictionaryAngles = {
		isoFL: "Isometric FL",
		isoFR: "Isometric FR",
		isoBL: "Isometric BL",
		isoBR: "Isometric BR",
		top: "Top",
		front: "Front",
		left: "Left",
		right: "Right",
		back: "Back",
		bottom: "Bottom",
	};
	import { cameraAnglesOptions } from "../logic/camera";
	import { zoomOptions } from "../logic/camera";
	import { dictionaryThemes, THEMES } from "../logic/themes";
	import { printCardState } from "../logic/printCardState";
	import { setupPrintCardForm } from "../logic/setupPrintCardForm";
	import {
		formatMetadata,
		type FormattedPrintCardMetadata,
	} from "../logic/formatMetadata";
	import html2canvas from "html2canvas";
	import {
		translations,
		getInitialLanguage,
		type Language,
	} from "../i18n/translations";

	let hasShadow = true;
	const printCard = document.querySelector<HTMLElement>(".printCard");
	const printCardBg =
		document.querySelector<HTMLImageElement>("#printCard-bg");
	const printCardImg = document.querySelector<HTMLImageElement>(
		".printCard-thumbnail",
	);
	const form = document.querySelector<HTMLFormElement>("#print-card-form");
	const fileNameTextButton = document.querySelector<HTMLSpanElement>(
		"#fileName-text-button",
	);
	const inputFile = document.querySelector<HTMLInputElement>("#gcode-file");
	const changeFileButton =
		document.querySelector<HTMLSpanElement>("#changeFile-button");
	const cropSelect =
		document.querySelector<HTMLSelectElement>("#crop-select");
	const benchyLoader = document.querySelector("#benchy-loader-form");
	const changeIcon = document.querySelector("#change-icon");
	form?.addEventListener("submit", async (e) => {
		e.preventDefault();

		if (!printCard) return;

		await document.fonts.ready;

		const exportScale = 3;

		const canvas = await html2canvas(printCard, {
			useCORS: true,
			scale: exportScale,
			backgroundColor: null,
		});

		let finalCanvas = canvas;

		if (hasShadow) {
			const shadowCanvas = await createShadowCanvas(canvas);

			if (!shadowCanvas) return;

			finalCanvas = shadowCanvas;
		}

		const link = document.createElement("a");

		link.download = "printcard.png";
		link.href = finalCanvas.toDataURL("image/png");

		link.click();
	});
	const language = getInitialLanguage();
	const texts = translations[language];
	const descriptionPlaceholder =
		document.querySelector<HTMLInputElement>("#description");

	for (const zoom of zoomOptions) {
		const option = document.createElement("option");

		option.value = zoom;
		option.dataset.i18nGroup = "zooms";
		option.dataset.i18nKey = zoom;

		option.textContent = texts.zooms[zoom as keyof typeof texts.zooms];

		document.getElementById("zoom-select")?.appendChild(option);
	}

	for (const angle of cameraAnglesOptions) {
		const option = document.createElement("option");

		option.value = angle;
		option.dataset.i18nGroup = "views";
		option.dataset.i18nKey = angle;

		option.textContent = texts.views[angle as keyof typeof texts.views];

		document.getElementById("view-select")?.appendChild(option);
	}

	for (const theme of THEMES) {
		const option = document.createElement("option");
		option.value = theme;
		option.textContent = dictionaryThemes[theme] || theme;
		document?.getElementById("theme-select")?.appendChild(option);
		document
			?.getElementById("theme-select")
			?.addEventListener("change", (event) => {
				const selectedTheme = (event.target as HTMLSelectElement).value;
				if (!printCard || !printCardBg) return;
				printCard.classList.remove(...THEMES);
				printCard.classList.add(selectedTheme);
				if (selectedTheme !== "theme-neon") {
					printCardBg.classList.remove("hide");
					printCardBg.src = `/public/assets/${selectedTheme.split("-")[1]}.png`;
					console.log(selectedTheme.split("-")[1]);
				} else {
					printCardBg.classList.add("hide");
				}
			});
	}

	window.addEventListener("print-card-metadata-ready", () => {
		const { printCardMetadata } = printCardState;

		if (!printCardMetadata) return;

		fillPrintCardForm(formatMetadata(printCardMetadata));
	});

	const shadowInput = document.getElementById(
		"shadow-input",
	) as HTMLInputElement;

	const borderInput = document.getElementById(
		"border-input",
	) as HTMLInputElement;

	changeFileButton?.addEventListener("click", () => {
		if (!inputFile) return;
		inputFile.value = "";
		inputFile.click();
	});
	window.addEventListener("print-card-preview-ready", () => {
		if (benchyLoader && changeIcon) {
			changeIcon.classList.remove("hide");
			benchyLoader.classList.add("hide");
		}
		if (!fileNameTextButton || !inputFile?.files?.[0]) return;

		fileNameTextButton.innerText = inputFile.files[0].name;
	});

	shadowInput.addEventListener("change", () => {
		if (shadowInput.checked) {
			printCard?.classList.add("shadow");
			hasShadow = true;
		} else {
			printCard?.classList.remove("shadow");
			hasShadow = false;
		}
	});
	borderInput.addEventListener("change", () => {
		if (borderInput.checked) {
			printCard?.classList.add("border");
		} else {
			printCard?.classList.remove("border");
		}
	});
	cropSelect?.addEventListener("change", (event) => {
		const select = event.currentTarget as HTMLSelectElement;
		const selectedValue = select.value;

		if (!selectedValue || !printCardImg) return;

		printCardImg.style.objectFit = selectedValue;
	});

	function fillPrintCardForm(metadata: FormattedPrintCardMetadata) {
		if (!form) return;

		for (const [key, value] of Object.entries(metadata)) {
			const input = form.elements.namedItem(key);

			if (input instanceof HTMLInputElement) {
				input.value = value ?? "";
			}
		}
	}

	async function createShadowCanvas(cardCanvas: HTMLCanvasElement) {
		const padding = 20;

		const shadowCanvas = document.createElement("canvas");

		shadowCanvas.width = cardCanvas.width + padding * 2;
		shadowCanvas.height = cardCanvas.height + padding * 2;

		const ctx = shadowCanvas.getContext("2d");

		if (!ctx) return null;

		ctx.save();

		ctx.shadowColor = "rgba(0, 0, 0, 0.1)";
		ctx.shadowBlur = 12;
		ctx.shadowOffsetX = 0;
		ctx.shadowOffsetY = 6;

		ctx.drawImage(cardCanvas, padding, padding);

		ctx.restore();

		ctx.drawImage(cardCanvas, padding, padding);

		return shadowCanvas;
	}

	if (form) {
		setupPrintCardForm(form);
	}
</script>
