---
import {
    ArrowDownToLine,
    Box,
    LayersArrowDown,
    RulerDimensionLine,
} from "@lucide/astro";
import BenchyLoader from "./BenchyLoader.astro";
---

<div class="gcode-container">
    <div id="upload-wrapper" class="upload-wrapper">
        <div id="upload-area" class="upload-area">
            <span class="corner tl"></span>
            <span class="corner tr"></span>
            <span class="corner br"></span>
            <span class="corner bl"></span>
            <input id="gcode-file" type="file" accept=".gcode,.gc,.gco" />

            <label for="gcode-file">
                <span class="icon-wrapper">
                    <ArrowDownToLine
                        class="arrow-icon"
                        size={28}
                        stroke-width={2}
                    />
                    <BenchyLoader size="36" class="benchy-loader hide" />
                </span>
                <p class="gcode-text">Suelta tu G-code o imagen aquí</p>
                <p class="gcode-file-name" id="file-name">
                    Ningún archivo seleccionado
                </p>
                <span class="gcode-line-separator"></span>
                <p class="drop-hint">o haz clic para buscar en tu equipo</p>
            </label>
        </div>
        <div class="decoration-metadata">
            <p>
                <RulerDimensionLine
                    size={20}
                    class="decoration-metadata-icon"
                />Dimensiones
            </p>
            <p><Box size={20} class="decoration-metadata-icon" />Material</p>
            <p>
                <LayersArrowDown
                    size={20}
                    class="decoration-metadata-icon"
                />Altura de capa
            </p>
        </div>
        <p class="upload-text">
            Cargar tu G-code, en casos compatibles, permite generar una vista
            previa de tu modelo y extraer metadatos de impresión. También puedes
            comenzar con una imagen.
        </p>
    </div>

    <div class="preview-wrapper">
        <canvas id="gcode-canvas"></canvas>
    </div>
</div>

<script>
    import * as THREE from "three";
    import {
        setCameraView,
        zoomOptions,
        type CameraAngle,
        type Zoom,
    } from "../logic/camera";
    import { processGCodeFile } from "../logic/processGCodeFile";
    import { captureCanvas } from "../logic/processGCodeFile";
    import { cameraAnglesOptions } from "../logic/camera";
    import { dictionaryModelColorSchemes } from "../logic/themes";
    import { setPrintCardPreview } from "../logic/printCardState";

    // =========================================================
    // ELEMENTOS
    // =========================================================

    const fileInput = document.querySelector<HTMLInputElement>("#gcode-file");
    const canvas = document.querySelector<HTMLCanvasElement>("#gcode-canvas");
    const fileNameElement = document.querySelector<HTMLElement>("#file-name");
    const uploadArea = document.querySelector<HTMLElement>("#upload-area");
    const uploadWrapper =
        document.querySelector<HTMLElement>("#upload-wrapper");
    const printCard = document.querySelector<HTMLElement>("#print-card");
    const controls = document.querySelector<HTMLElement>("#controls");
    const viewSelect =
        document.querySelector<HTMLSelectElement>("#view-select");
    const zoomSelect =
        document.querySelector<HTMLSelectElement>("#zoom-select");
    const themeSelect =
        document.querySelector<HTMLSelectElement>("#theme-select");
    const arrowIcon = document.querySelector<HTMLElement>(".arrow-icon");
    const benchyLoader = document.querySelector<HTMLElement>(".benchy-loader");

    const setLoading = (loading: boolean) => {
        arrowIcon?.classList.toggle("hide", loading);
        benchyLoader?.classList.toggle("hide", !loading);
    };

    if (
        !fileInput ||
        !canvas ||
        !fileNameElement ||
        !uploadArea ||
        !uploadWrapper ||
        !printCard ||
        !controls ||
        !viewSelect ||
        !zoomSelect ||
        !themeSelect
    ) {
        throw new Error("No se encontraron los elementos necesarios");
    }

    // =========================================================
    // RESOLUCIÓN REAL DEL CANVAS
    // =========================================================

    canvas.width = 2000;
    canvas.height = 2000;

    let file: File | undefined = undefined;
    let preview: any = null;
    let renderer: THREE.WebGLRenderer | null = null;
    let scene: THREE.Scene | null = null;
    let camera: THREE.Camera | null = null;
    let currentImageUrl: string | null = null;
    let currentAngle: CameraAngle = cameraAnglesOptions[0];
    let currentZoom: Zoom = zoomOptions[0];
    let currentModelColor: string =
        dictionaryModelColorSchemes["theme-blueprint"];
    // =========================================================
    // DRAG & DROP
    // =========================================================

    uploadArea.addEventListener("dragover", (event) => {
        event.preventDefault();

        uploadArea.classList.add("drag-over");
    });

    uploadArea.addEventListener("dragleave", () => {
        uploadArea.classList.remove("drag-over");
    });

    uploadArea.addEventListener("drop", async (event) => {
        event.preventDefault();
        setLoading(true);
        uploadArea.classList.remove("drag-over");

        const droppedFile = event.dataTransfer?.files?.[0];

        if (!droppedFile) {
            setLoading(false);
            return;
        }

        const extension = droppedFile.name.split(".").pop()?.toLowerCase();

        if (
            extension !== "gcode" &&
            extension !== "gc" &&
            extension !== "gco"
        ) {
            console.warn("Archivo no compatible");
            return;
        }

        file = droppedFile;

        fileNameElement.textContent = file.name;

        const result = await processGCodeFile(file, canvas, currentModelColor);

        if (result?.ok) {
            preview = result.preview;
            renderer = result.renderer;
            scene = result.scene;
            camera = result.camera;

            uploadWrapper.classList.add("hide");
            printCard.classList.remove("hide");
            controls.classList.remove("hide");
            setLoading(false);
        }
    });

    // =========================================================
    // CARGAR G-CODE
    // =========================================================

    async function updatePrintCardImage() {
        if (!preview || !renderer || !scene || !camera || !canvas) {
            console.warn("No se ha cargado ningún modelo");
            return;
        }

        const image = await captureCanvas(renderer, scene, camera, canvas);

        if (!image) return;

        if (currentImageUrl) {
            URL.revokeObjectURL(currentImageUrl);
        }

        currentImageUrl = image;

        // Actualizar el estado compartido
        setPrintCardPreview(image);

        // Avisar a PrintCard de que el estado cambió
        window.dispatchEvent(new CustomEvent("print-card-state-ready"));
    }

    function setPrintCardLoading(loading: boolean) {
        window.dispatchEvent(
            new CustomEvent("print-card-update", {
                detail: {
                    loading: loading,
                },
            }),
        );
    }

    fileInput.addEventListener("change", async (event) => {
        const input = event.currentTarget as HTMLInputElement;
        setLoading(true);

        file = input.files?.[0];

        if (!file) {
            setLoading(false);
            return;
        }

        fileNameElement.textContent = file.name;

        const result = await processGCodeFile(file, canvas, currentModelColor);
        if (result?.ok) {
            preview = result.preview;
            renderer = result.renderer;
            scene = result.scene;
            camera = result.camera;

            uploadWrapper.classList.add("hide");
            printCard.classList.remove("hide");
            controls.classList.remove("hide");
            setLoading(false);
        }
    });

    viewSelect.addEventListener("change", async (event) => {
        if (!preview) return;
        setPrintCardLoading(true);

        const select = event.currentTarget as HTMLSelectElement;
        const selectedValue = select.value as CameraAngle;

        if (!selectedValue) return setPrintCardLoading(false);

        currentAngle = selectedValue;

        setCameraView(preview, currentAngle, currentZoom);

        await updatePrintCardImage();
        setPrintCardLoading(false);
    });

    zoomSelect.addEventListener("change", async (event) => {
        if (!preview) return;
        setPrintCardLoading(true);

        const select = event.currentTarget as HTMLSelectElement;
        const selectedValue = select.value as Zoom;

        if (!selectedValue) return setPrintCardLoading(false);

        currentZoom = selectedValue;

        setCameraView(preview, currentAngle, currentZoom);

        await updatePrintCardImage();
        setPrintCardLoading(false);
    });

    themeSelect.addEventListener("change", async (event) => {
        const select = event.currentTarget as HTMLSelectElement;
        const selectedValue =
            select.value as keyof typeof dictionaryModelColorSchemes;
        setPrintCardLoading(true);

        if (!selectedValue) return setPrintCardLoading(false);

        currentModelColor = dictionaryModelColorSchemes[selectedValue];

        console.log(
            "Selected theme:",
            selectedValue,
            "Model color:",
            currentModelColor,
        );

        if (!file) return;

        const result = await processGCodeFile(
            file,
            canvas,
            currentModelColor,
            currentAngle,
            currentZoom,
        );

        if (!result?.ok) return;

        preview = result.preview;
        renderer = result.renderer;
        scene = result.scene;
        camera = result.camera;

        await updatePrintCardImage();
        setPrintCardLoading(false);
    });
</script>

<style>
    * {
        font-family: "Google Sans", sans-serif;
    }

    .gcode-container {
    }

    .upload-wrapper {
        display: flex;
        flex-direction: column;
        gap: 16px;
        max-width: 720px;
        align-items: center;
    }

    .upload-text {
        font-size: 14px;
        color: var(--placeholder);
        text-align: center;
        max-width: 600px;
    }

    .upload-area {
        position: relative;
        width: 100%;
        max-width: 500px;
        height: 260px;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        text-align: center;

        border-radius: 4px;
        border-color: #8080aa;
        background-color: var(--bg-elevated);
        margin-bottom: 32px;

        transition:
            border-color 0.15s ease,
            background-color 0.15s ease;
    }

    .upload-area.drag-over {
        background-color: var(--bg-elevated-hover);
    }

    .upload-area.drag-over .corner {
        border-color: var(--hover);
        /* background-color: rgba(30, 144, 255, 0.08); */
    }

    .upload-area .drop-hint {
        font-size: 13px;
        color: var(--placeholder);
    }

    .upload-area input[type="file"] {
        display: none;
    }

    .upload-area > * {
        position: relative;
        z-index: 1;
    }

    .upload-area .corner {
        position: absolute;
        width: 26px;
        height: 26px;
        z-index: 0;
        border-color: var(--accent-dark);
        border-style: solid;
        --border-width: 3px;
    }

    .corner.tl {
        border-top-left-radius: inherit;
        left: 0;
        top: 0;
        border-width: var(--border-width) 0px 0px var(--border-width);
    }
    .corner.tr {
        border-top-right-radius: inherit;
        right: 0;
        top: 0;
        border-width: var(--border-width) var(--border-width) 0px 0px;
    }
    .corner.bl {
        border-bottom-left-radius: inherit;
        left: 0;
        bottom: 0;
        border-width: 0px 0px var(--border-width) var(--border-width);
    }
    .corner.br {
        border-bottom-right-radius: inherit;
        right: 0;
        bottom: 0;
        border-width: 0px var(--border-width) var(--border-width) 0px;
    }

    .upload-area label {
        display: flex;
        flex-direction: column;
        align-items: center;
        cursor: pointer;
        padding: 32px;
        width: 100%;
    }

    .icon-wrapper {
        background-color: var(--accent-soft);
        aspect-ratio: 1;
        border-radius: 99999999px;
        margin-bottom: 16px;
        height: 64px;
        position: relative;
        color: var(--accent-dark);
    }

    .arrow-icon {
        position: absolute;
        left: 50%;
        top: 50%;
        transform: translate(-50%, -50%);
    }

    .benchy-loader {
        position: absolute;
        left: 50%;
        top: 50%;
        transform: translate(-50%, -50%);
    }
    .arrow-icon.hide {
        display: none;
    }

    .benchy-loader.hide {
        display: none;
    }

    .gcode-text {
        font-size: 18px;
        font-weight: 700;
        margin-bottom: 6px;
    }

    #file-name {
        font-size: 14px;
        color: var(--muted);
    }

    .gcode-line-separator {
        width: 100%;
        height: 2px;
        background-color: var(--border);
        margin: 16px 0;
        opacity: 0.75;
    }

    .upload-wrapper.hide {
        display: none;
    }

    .decoration-metadata {
        display: flex;
        align-items: center;
        justify-content: space-between;
        width: 100%;
        max-width: 500px;
        padding-inline: 16px;
        font-size: 14px;
        color: var(--ink);
        margin-bottom: 8px;
    }

    .decoration-metadata p {
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .decoration-metadata p {
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .decoration-metadata-icon {
        color: var(--accent-dark);
    }

    #gcode-canvas {
        width: 500px;
        height: 500px;
        opacity: 0;
        position: absolute;
        pointer-events: none;
        z-index: -9999;
        left: 0;
        top: 0;
    }
</style>
