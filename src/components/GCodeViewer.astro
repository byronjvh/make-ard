---

---

<div class="gcode-container">
    <div class="upload-area">
        <input id="gcode-file" type="file" accept=".gcode,.gc,.gco" />

        <label for="gcode-file"> Seleccionar G-code </label>

        <p id="file-name">Ningún archivo seleccionado</p>
    </div>

    <div class="preview-wrapper">
        <canvas id="gcode-canvas"></canvas>
    </div>
</div>

<script>
    import { GCodePreview } from "gcode-preview";
    import { removePurgeLines } from "../logic/GCodeRemovePurgeLines";
    import { setCameraView } from "../utils/camera";

    const fileInput = document.querySelector<HTMLInputElement>("#gcode-file");

    const canvas = document.querySelector<HTMLCanvasElement>("#gcode-canvas");

    const fileNameElement = document.querySelector<HTMLElement>("#file-name");

    if (!fileInput || !canvas || !fileNameElement) {
        throw new Error("No se encontraron los elementos necesarios");
    }

    // Resolución real
    canvas.width = 2000;
    canvas.height = 2000;

    // =========================================================
    // GCODE PREVIEW 3.0
    // =========================================================

    const preview = new GCodePreview({
        canvas,

        renderTravel: false,
        renderExtrusion: true,
        renderTubes: true,

        lineWidth: 2,
        extrusionWidth: 1,

        backgroundColor: "#001828",
        extrusionColor: "#1e90ff",

        buildVolume: {
            x: 300,
            y: 300,
            z: 300,
            smallGrid: false,
        },
    });

    const sceneManager = preview.sceneManager;

    sceneManager.scene.traverse((object: any) => {
        if (object.name === "BuildVolume") {
            object.visible = false;
        }
    });

    // =========================================================
    // DESACTIVAR CONTROLES
    // =========================================================

    sceneManager.controls.enabled = false;

    // =========================================================
    // CARGAR G-CODE
    // =========================================================

    fileInput.addEventListener("change", async (event) => {
        const input = event.currentTarget as HTMLInputElement;

        const file = input.files?.[0];

        if (!file) return;

        fileNameElement.textContent = file.name;

        const originalGCode = await file.text();

        const result = removePurgeLines(originalGCode);

        await preview.processGCode(result.gcode);

        // IMPORTANTE:
        // ahora la cámara se obtiene desde
        // preview.sceneManager
        setCameraView(preview, "isometric");
    });
</script>

<style>
    .gcode-container {
        width: 100%;
        max-width: 500px;
        margin: auto;
    }

    .upload-area {
        padding: 2rem;
        text-align: center;
    }

    .upload-area input[type="file"] {
        display: none;
    }

    .upload-area label {
        display: inline-block;
        padding: 0.75rem 1.5rem;

        border-radius: 0.5rem;

        background: #ffffff;
        color: #001828;

        cursor: pointer;
        font-weight: 600;
    }

    .preview-wrapper {
        width: 100%;
        aspect-ratio: 1 / 1;

        background: #001828;

        overflow: hidden;
    }

    #gcode-canvas {
        width: 100%;
        height: 100%;

        display: block;
    }
</style>
