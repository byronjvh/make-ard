---

---

<div class="gcode-container">
    <div class="upload-area">
        <input id="gcode-file" type="file" accept=".gcode,.gc,.gco" />

        <label for="gcode-file"> Seleccionar G-code </label>

        <p id="file-name">Ningún archivo seleccionado</p>
    </div>

    <div class="preview-wrapper">
        <canvas id="gcode-canvas"></canvas>
    </div>
</div>

<script>
    import { GCodePreview } from "gcode-preview";
    import { removePurgeLines } from "../logic/GCodeRemovePurgeLines";
    import { setCameraView, type CameraAngle } from "../logic/camera";
    import { modelCenter } from "../logic/modelCenter";
    import { getGCodeBounds } from "../logic/getGCodeBounds";
    import * as THREE from "three";

    // =========================================================
    // ELEMENTOS
    // =========================================================

    const fileInput = document.querySelector<HTMLInputElement>("#gcode-file");

    const canvas = document.querySelector<HTMLCanvasElement>("#gcode-canvas");

    const fileNameElement = document.querySelector<HTMLElement>("#file-name");

    if (!fileInput || !canvas || !fileNameElement) {
        throw new Error("No se encontraron los elementos necesarios");
    }

    // =========================================================
    // RESOLUCIÓN REAL DEL CANVAS
    // =========================================================

    canvas.width = 2000;
    canvas.height = 2000;

    // =========================================================
    // CARGAR G-CODE
    // =========================================================

    fileInput.addEventListener("change", async (event) => {
        const input = event.currentTarget as HTMLInputElement;

        const file = input.files?.[0];

        if (!file) return;

        fileNameElement.textContent = file.name;

        const originalGCode = await file.text();

        const result = removePurgeLines(originalGCode);

        const gcode = result.gcode;

        const bounds = getGCodeBounds(gcode);

        if (!bounds) {
            console.error("No se pudo calcular el volumen del G-code.");

            return;
        }

        // =================================================
        // PEQUEÑO MARGEN
        // =================================================

        const margin = 10;

        const buildVolume = {
            x: Math.max(bounds.sizeX + margin, 1),

            y: Math.max(bounds.sizeY + margin, 1),

            z: Math.max(bounds.sizeZ + margin, 1),
            smallGrid: false,
        };

        // =================================================
        // CREAR PREVIEW
        // =================================================

        const preview = new GCodePreview({
            canvas,

            buildVolume,

            renderTravel: false,
            renderExtrusion: true,
            renderTubes: true,

            lineWidth: 2,
            lineHeight: 1,

            backgroundColor: "#001828",

            extrusionColor: "#1e90ff",
        });

        const buildVolumeFromScene =
            preview.sceneManager.scene.getObjectByName("BuildVolume");

        if (buildVolumeFromScene) {
            buildVolumeFromScene.visible = false;
        }

        // =================================================
        // PROCESAR
        // =================================================

        canvas.style.visibility = "hidden";

        await preview.processGCode(gcode);

        canvas.style.visibility = "visible";

        const extrusions =
            preview.sceneManager.scene.getObjectByName("Extrusions");

        extrusions?.traverse((object: any) => {
            if (!object.isMesh) return;

            const material = object.material;

            if (!material.isShaderMaterial) return;

            material.fragmentShader = material.fragmentShader.replace(
                "vec3 lightDir = normalize(vec3(-0.8, -0.2, -0.8));",
                "vec3 lightDir = normalize(vec3(0,-0.3,-1));",
            );
            material.fragmentShader = material.fragmentShader.replace(
                "float diff = max(dot(vNormal, -lightDir), 0.0) * directional;",
                "float diff = max(dot(vNormal, -lightDir), 0.3) * directional;",
            );

            material.uniforms.ambient.value = 0.4;
            material.uniforms.directional.value = 0.7;
            material.uniforms.brightness.value = 1.2;

            material.needsUpdate = true;
        });

        const scene = preview.sceneManager.scene;

        modelCenter(scene, buildVolume);

        const cameraButtons = [
            "isometric",
            "isometric2",
            "front",
            "back",
            "left",
            "right",
            "top",
        ] as const;

        setCameraView(preview, cameraButtons[0]);

        const cameraContainer = document.createElement("div");

        cameraContainer.style.display = "flex";
        cameraContainer.style.flexWrap = "wrap";
        cameraContainer.style.gap = "5px";
        cameraContainer.style.marginTop = "10px";

        for (const angle of cameraButtons) {
            const button = document.createElement("button");

            button.textContent = angle;

            button.style.cursor = "pointer";
            button.style.padding = "6px 10px";

            button.addEventListener("click", () => {
                setCameraView(preview, angle as CameraAngle);
            });

            cameraContainer.appendChild(button);
        }

        document
            .querySelector(".gcode-container")
            ?.appendChild(cameraContainer);
    });
</script>

<style>
    .gcode-container {
        width: 100%;
        max-width: 500px;
        margin: auto;
    }

    .upload-area {
        padding: 2rem;
        text-align: center;
    }

    .upload-area input[type="file"] {
        display: none;
    }

    .upload-area label {
        display: inline-block;
        padding: 0.75rem 1.5rem;

        border-radius: 0.5rem;

        background: #ffffff;
        color: #001828;

        cursor: pointer;
        font-weight: 600;
    }

    .preview-wrapper {
        width: 100%;
        aspect-ratio: 1 / 1;

        background: #001828;

        overflow: hidden;
    }

    #gcode-canvas {
        width: 100%;
        height: 100%;

        display: block;
    }
</style>
