---
import "../styles/global.css";
const site = "https://makeard.com";
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" href="/favicon.ico" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link rel="canonical" href={site} />
		<meta name="robots" content="index, follow" />
		<link
			crossorigin="anonymous"
			href="https://fonts.googleapis.com/css2?family=Google+Sans:ital,opsz,wght@0,17..18,400..700;1,17..18,400..700&family=Ubuntu+Sans:ital,wght@0,100..800;1,100..800&display=swap"
			rel="stylesheet"
		/>
		<meta name="generator" content={Astro.generator} />
		<title data-i18n="siteTitle">Make-ard — 3D Printing Model Cards</title>

		<!-- Open Graph -->
		<meta property="og:type" content="website" />
		<meta property="og:url" content={site} />
		<meta
			property="og:title"
			content="Make-ard — 3D Printing Model Cards"
		/>
		<meta
			property="og:description"
			content="Create beautiful, shareable cards for your 3D printing models."
		/>
		<meta property="og:image" content={`${site}/og-image.png`} />

		<!-- Twitter / X -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta
			name="twitter:title"
			content="Make-ard — 3D Printing Model Cards"
		/>
		<meta
			name="twitter:description"
			content="Create beautiful, shareable cards for your 3D printing models."
		/>
		<meta name="twitter:image" content={`${site}/og-image.png`} />

		<script type="application/ld+json">
			{
				"@context": "https://schema.org",
				"@type": "WebApplication",
				"name": "Make-ard",
				"url": "https://makeard.com",
				"description": "Create shareable cards for 3D printing models with model data, previews and customizable themes.",
				"applicationCategory": "DesignApplication",
				"operatingSystem": "Web"
			}
		</script>
	</head>
	<body>
		<slot />
		<div class="desktop-ad-layout">
			<div class="desktop-ad desktop-ad-left">
				<script is:inline>
					atOptions = {
						key: "d3dfeb3ed7f8f9a65078bfbb9c253c0b",
						format: "iframe",
						height: 600,
						width: 160,
						params: {},
					};
				</script>
				<script
					is:inline
					src="https://www.highrevenueformat.com/d3dfeb3ed7f8f9a65078bfbb9c253c0b/invoke.js"
				></script>
			</div>
			<div class="desktop-ad desktop-ad-right">
				<script is:inline>
					atOptions = {
						key: "2c7eb7f3db0daa12e21e9889e0e480a7",
						format: "iframe",
						height: 600,
						width: 160,
						params: {},
					};
				</script>
				<script
					is:inline
					src="https://www.highrevenueformat.com/2c7eb7f3db0daa12e21e9889e0e480a7/invoke.js"
				></script>
			</div>
		</div>
		<div class="mobile-ad-layout">
			<div id="mobile-ad" class="mobile-ad">
				<script is:inline>
					atOptions = {
						key: "874b7b5463f29d8fa0d0e5d811328846",
						format: "iframe",
						height: 50,
						width: 320,
						params: {},
					};
				</script>
				<script
					is:inline
					src="https://www.highrevenueformat.com/874b7b5463f29d8fa0d0e5d811328846/invoke.js"
				></script>
			</div>

			<div class="mobile-ad-tablet">
				<script is:inline>
					atOptions = {
						key: "289fdc5c3c0005942f17504449b9991b",
						format: "iframe",
						height: 90,
						width: 728,
						params: {},
					};
				</script>
				<script
					is:inline
					src="https://www.highrevenueformat.com/289fdc5c3c0005942f17504449b9991b/invoke.js"
				></script>
			</div>
		</div>
	</body>
</html>

<style>
	body {
		font-family: sans-serif;
		background-color: var(--bg);
		max-width: 100svw;
		overflow: hidden auto;
		position: relative;
	}
	.mobile-ad-layout {
		height: 100%;
		width: 100%;
		position: fixed;
		left: 0;
		top: 0;
		display: flex;
		flex-direction: column;
		justify-content: end;
		align-items: center;
		padding-bottom: 4px;
	}

	.mobile-ad {
		/* background-color: red; */
		width: 320px;
		height: 50px;
	}
	.mobile-ad-tablet {
		width: 728px;
		height: 90px;
		display: none;
	}

	.desktop-ad-layout {
		position: absolute;
		left: 0;
		top: 0;
		width: 100%;
		height: 100%;
		display: flex;
		justify-content: space-between;
		padding-inline: 16px;
	}

	.desktop-ad {
		width: 160px;
		height: 600px;
		position: sticky;
		top: 60px;
		margin-top: 150px;
	}

	/* Móvil */
	@media screen and (max-width: 767px) {
		.mobile-ad {
			display: block;
		}

		.mobile-ad-tablet,
		.desktop-ad {
			display: none;
		}
	}

	/* Tablet */
	@media screen and (min-width: 768px) and (max-width: 1399px) {
		.mobile-ad {
			display: none;
		}

		.mobile-ad-tablet {
			display: block;
		}

		.desktop-ad {
			display: none;
		}
	}

	/* Desktop */
	@media screen and (min-width: 1400px) {
		.mobile-ad,
		.mobile-ad-tablet {
			display: none;
		}

		.desktop-ad {
			display: block;
		}
	}
</style>
