---
import "../styles/global.css";
const site = "https://makeard.com";
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" href="/favicon.ico" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link rel="canonical" href={site} />
		<meta name="robots" content="index, follow" />
		<link
			crossorigin="anonymous"
			href="https://fonts.googleapis.com/css2?family=Google+Sans:ital,opsz,wght@0,17..18,400..700;1,17..18,400..700&family=Ubuntu+Sans:ital,wght@0,100..800;1,100..800&display=swap"
			rel="stylesheet"
		/>
		<meta name="generator" content={Astro.generator} />
		<title data-i18n="siteTitle">Make-ard — 3D Printing Model Cards</title>

		<!-- Open Graph -->
		<meta property="og:type" content="website" />
		<meta property="og:url" content={site} />
		<meta
			property="og:title"
			content="Make-ard — 3D Printing Model Cards"
		/>
		<meta
			property="og:description"
			content="Create beautiful, shareable cards for your 3D printing models."
		/>
		<meta property="og:image" content={`${site}/og-image.png`} />

		<!-- Twitter / X -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta
			name="twitter:title"
			content="Make-ard — 3D Printing Model Cards"
		/>
		<meta
			name="twitter:description"
			content="Create beautiful, shareable cards for your 3D printing models."
		/>
		<meta name="twitter:image" content={`${site}/og-image.png`} />

		<script type="application/ld+json">
			{
				"@context": "https://schema.org",
				"@type": "WebApplication",
				"name": "Make-ard",
				"url": "https://makeard.com",
				"description": "Create shareable cards for 3D printing models with model data, previews and customizable themes.",
				"applicationCategory": "DesignApplication",
				"operatingSystem": "Web"
			}
		</script>
	</head>
	<body>
		<slot />
	</body>
</html>

<style>
	body {
		font-family: sans-serif;
		background-color: var(--bg);
		max-width: 100svw;
		overflow: hidden auto;
	}
</style>
